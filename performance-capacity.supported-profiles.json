{
  "$schema": "./scripts/performance-profile-capacity.schema.json",
  "schemaVersion": "tixkit-supported-profile-capacity-config-v2",
  "claimScope": "supported-profile-capacity-eligibility",
  "denials": [
    "capacity proof without profile-scoped hosted evidence",
    "Cloud capacity",
    "SLA or SLO attainment",
    "soak stability",
    "fault tolerance"
  ],
  "profiles": [
    {
      "id": "compact",
      "deployment": {
        "kind": "compact-compose",
        "files": ["infra/compact/.env.example", "infra/compact/compose.yml"],
        "manifestSha256": "651474b2140bee5c91c94fe46a0b402773a1c3c307d898f08334a8c65992598a"
      },
      "database": { "engine": "postgresql", "topology": "bundled-single-instance" },
      "resources": {
        "api": {
          "replicas": 1,
          "cpuQuotaMillis": 1000,
          "memoryLimitMiB": 1024
        },
        "worker": {
          "replicas": 1,
          "cpuQuotaMillis": 1000,
          "memoryLimitMiB": 1024
        }
      },
      "workload": {
        "id": "checkout-reservation-v1",
        "inventory": 64,
        "concurrencyPoints": [16, 32, 64, 128],
        "samplesPerPoint": 3,
        "minimumDurationSeconds": 900,
        "maximumP95Ms": 2000,
        "requireZeroPlatformFailures": true
      }
    },
    {
      "id": "production",
      "deployment": {
        "kind": "production-helm",
        "files": [
          "infra/helm/tixkit/Chart.yaml",
          "infra/helm/tixkit/values.yaml",
          "infra/helm/tixkit/values-production.yaml",
          "infra/helm/tixkit/templates/_helpers.tpl",
          "infra/helm/tixkit/templates/api.yaml",
          "infra/helm/tixkit/templates/apps.yaml",
          "infra/helm/tixkit/templates/availability.yaml",
          "infra/helm/tixkit/templates/configmap.yaml",
          "infra/helm/tixkit/templates/external-secret.yaml",
          "infra/helm/tixkit/templates/ingress.yaml",
          "infra/helm/tixkit/templates/migration-network-policy.yaml",
          "infra/helm/tixkit/templates/migration-secret.yaml",
          "infra/helm/tixkit/templates/migrations.yaml",
          "infra/helm/tixkit/templates/minio.yaml",
          "infra/helm/tixkit/templates/monitoring.yaml",
          "infra/helm/tixkit/templates/network-policy.yaml",
          "infra/helm/tixkit/templates/postgres.yaml",
          "infra/helm/tixkit/templates/redis.yaml",
          "infra/helm/tixkit/templates/secret.yaml",
          "infra/helm/tixkit/templates/service-account.yaml",
          "infra/helm/tixkit/templates/temporal.yaml",
          "infra/helm/tixkit/templates/worker.yaml"
        ],
        "manifestSha256": "ef11d1104bfa60c198256495908b71899c1f2d647a21dc1e3585ebeaa1e72921"
      },
      "database": { "engine": "postgresql", "topology": "external-high-availability" },
      "resources": {
        "api": {
          "replicas": 2,
          "cpuQuotaMillis": 1000,
          "memoryLimitMiB": 1024
        },
        "worker": {
          "replicas": 2,
          "cpuQuotaMillis": 1000,
          "memoryLimitMiB": 1024
        }
      },
      "workload": {
        "id": "checkout-reservation-v1",
        "inventory": 64,
        "concurrencyPoints": [16, 32, 64, 128],
        "samplesPerPoint": 3,
        "minimumDurationSeconds": 1800,
        "maximumP95Ms": 2000,
        "requireZeroPlatformFailures": true
      }
    }
  ]
}
