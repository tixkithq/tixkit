# Tixkit local development environment
#
# Use this as the starting point for `.env.local`.
# Root scripts load this file with `bun --env-file=.env.local`.
# Never commit real secrets. If a real provider key is ever copied into
# `.env.local`, rotate it before sharing logs, screenshots, or branches.

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Observability
# API and worker emit OpenTelemetry traces to this collector endpoint.
# Set OTEL_SDK_DISABLED=true only for focused local debugging.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_SDK_DISABLED=false
PROMETHEUS_PUSHGATEWAY_URL=
METRICS_BEARER_TOKEN=

# Local API
API_BASE_URL=http://localhost:4000
ADMIN_DASHBOARD_URL=http://localhost:3001
NEXT_PUBLIC_TIXKIT_API_BASE_URL=http://localhost:4000/v1
NEXT_PUBLIC_ADMIN_API_BASE_URL=http://localhost:4000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
TRUST_PROXY=false
API_COMPRESSION_THRESHOLD_BYTES=1024

# PostgreSQL
DATABASE_URL=postgres://tixkit:tixkit@localhost:5432/tixkit
POSTGRES_POOL_MIN=1
POSTGRES_POOL_MAX=10
POSTGRES_POOL_IDLE_TIMEOUT_MS=30000
POSTGRES_POOL_CONNECTION_TIMEOUT_MS=5000

# MySQL (Tier 1, tested in CI)
DATABASE_URL_MYSQL=mysql://tixkit:tixkit@localhost:3306/tixkit
MYSQL_POOL_MIN=1
MYSQL_POOL_MAX=10
MYSQL_POOL_IDLE_TIMEOUT_MS=30000
MYSQL_POOL_CONNECTION_TIMEOUT_MS=5000

# MSSQL (Tier 1, tested in CI)
DATABASE_URL_MSSQL=sqlserver://sa:password@localhost:1433/tixkit?encrypt=false&trustServerCertificate=true
MSSQL_POOL_MIN=1
MSSQL_POOL_MAX=10
MSSQL_POOL_IDLE_TIMEOUT_MS=30000
MSSQL_POOL_CONNECTION_TIMEOUT_MS=5000

# Redis
REDIS_URL=redis://localhost:6379

# Signing
QR_SIGNING_SECRET=<qr-signing-secret-required-in-production>
OFFLINE_MANIFEST_SIGNING_KEY=<offline-manifest-signing-key-required-in-production>
OFFLINE_MANIFEST_KEY_ID=manifest:v1
WIDGET_IMPRESSION_HASH_SECRET=<widget-impression-hash-secret-required-in-production>

# Wallet passes
# Development skips pass generation unless a provider is fully configured.
# Production fails closed when enabled providers are missing signing keys.
APPLE_WALLET_ENABLED=false
APPLE_WALLET_PASS_TYPE_ID=
APPLE_WALLET_TEAM_ID=
APPLE_WALLET_ORGANIZATION_NAME=Tixkit
APPLE_WALLET_SIGNER_CERT=
APPLE_WALLET_SIGNER_KEY=
APPLE_WALLET_SIGNER_KEY_PASSPHRASE=
APPLE_WALLET_WWDR_CERT=
GOOGLE_WALLET_ENABLED=false
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_CLASS_SUFFIX=tixkit_event
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
GOOGLE_WALLET_PRIVATE_KEY=
GOOGLE_WALLET_ORIGIN=http://localhost:3001

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=tixkit
TEMPORAL_WORKER_TASK_QUEUES=tixkit
TEMPORAL_EXPORT_TASK_QUEUE=tixkit-export
TEMPORAL_PDF_TASK_QUEUE=tixkit-pdf
TEMPORAL_WALLET_TASK_QUEUE=tixkit-wallet
TEMPORAL_WORKER_MAX_CONCURRENT_ACTIVITY_TASK_EXECUTIONS=20
TEMPORAL_WORKER_MAX_CONCURRENT_WORKFLOW_TASK_EXECUTIONS=20
TEMPORAL_WORKER_MAX_CACHED_WORKFLOWS=100
TICKET_PDF_GENERATION_CONCURRENCY=4
WALLET_PASS_GENERATION_CONCURRENCY=2

# Clerk
AUTH_PROVIDER=dev
NEXT_PUBLIC_AUTH_PROVIDER=dev
CLERK_SECRET_KEY=<clerk-secret-key-or-empty-for-local-dev>
CLERK_PUBLISHABLE_KEY=<clerk-publishable-key-or-empty-for-local-dev>
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=<clerk-publishable-key-or-empty-for-local-dev>
CLERK_WEBHOOK_SECRET=<clerk-webhook-secret-or-empty-for-local-dev>

# Stripe
STRIPE_SECRET_KEY=<stripe-secret-key-or-empty-for-capture-mode>
STRIPE_WEBHOOK_SECRET=<stripe-webhook-secret-or-empty-for-capture-mode>
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=<stripe-publishable-key-or-empty-for-capture-mode>

# Email delivery (Resend)
# When set, local API/worker use Resend instead of capture, and dev seed creates
# an active provider route for brd_dev_local with a verified sender identity.
# Do not put inline # comments on the same line as values.
RESEND_API_KEY=
# Free-tier default is onboarding@resend.dev.
# With that address, Resend only delivers to the email on your Resend account
# (not arbitrary Gmail/iCloud recipients). To send to any inbox, verify a domain
# at https://resend.com/domains and set RESEND_FROM_EMAIL to that domain.
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=Tixkit Dev

# Email feedback webhooks
EMAIL_WEBHOOK_SECRET=<email-feedback-webhook-secret-or-empty-for-local-dev>

# SMS providers (optional; Telnyx is the primary SMS route)
TELNYX_API_KEY=
TELNYX_WEBHOOK_PUBLIC_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
VONAGE_API_KEY=
VONAGE_API_SECRET=
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=

# S3-compatible storage
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=tixkit
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1
UPLOAD_MALWARE_SCANNER=eicar
# Production should set UPLOAD_MALWARE_SCANNER=clamav and provide CLAMAV_HOST/CLAMAV_PORT.
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310
# Public documentation origin used by dashboard Help and Developer links.
NEXT_PUBLIC_TIXKIT_DOCS_URL=http://localhost:3002
