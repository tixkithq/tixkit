{
  "name": "tixkit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Headless white-label event commerce platform",
  "license": "UNLICENSED",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check:performance-budgets": "node scripts/check-performance-budgets.mjs",
    "check:lighthouse-budgets": "node scripts/check-performance-budgets.mjs --config performance-budgets.lighthouse.json",
    "dev": "bun run --env-file=.env.local turbo run dev",
    "dev:api": "bun run --env-file=.env.local --filter @tixkit/api dev",
    "dev:checkout": "bun run --env-file=.env.local --filter @tixkit/checkout dev -- -p 3000",
    "dev:admin": "bun run --env-file=.env.local --filter @tixkit/admin-dashboard dev -- -p 3001",
    "dev:worker": "bun run --env-file=.env.local --filter @tixkit/workflows dev",
    "dev:all": "sh -c 'bun run dev:api & bun run dev:worker & bun run dev:checkout & bun run dev:admin & bun run dev:docs & wait'",
    "quickstart": "bun run --env-file=.env.local --filter tixkit quickstart",
    "compact:init": "node scripts/compact.mjs init",
    "compact:up": "node scripts/compact.mjs up",
    "compact:status": "node scripts/compact.mjs status",
    "compact:logs": "node scripts/compact.mjs logs",
    "compact:backup": "node scripts/compact.mjs backup",
    "compact:restore": "node scripts/compact.mjs restore",
    "compact:upgrade": "node scripts/compact.mjs upgrade",
    "compact:uninstall": "node scripts/compact.mjs uninstall",
    "seed:sample-data": "bun run --env-file=.env.local --filter tixkit seed:sample-data",
    "init": "bun run --filter tixkit init",
    "embed:generate": "bun run --filter tixkit embed:generate",
    "sync:widget-public": "node scripts/sync-widget-public.mjs",
    "sync:embed-fixtures": "bun scripts/generate-embed-fixtures.mjs",
    "setup:check": "bun run --env-file=.env.local --filter tixkit setup:check",
    "dev:webhooks": "bun run --env-file=.env.local --filter tixkit dev:webhooks",
    "dev:docs": "bun run --filter @tixkit/docs dev",
    "docs:build": "bun run --filter @tixkit/docs build",
    "docs:test:e2e": "playwright test --config playwright.docs.config.ts",
    "docs:frontmatter": "node scripts/docs/check-frontmatter.mjs",
    "docs:navigation": "node scripts/docs/check-navigation.mjs",
    "docs:links": "node scripts/docs/check-links.mjs",
    "docs:redirects": "node scripts/docs/check-redirects.mjs",
    "docs:performance": "node scripts/docs/check-performance.mjs",
    "docs:readmes": "node scripts/docs/check-package-readmes.mjs",
    "docs:examples": "node scripts/docs/check-code-examples.mjs",
    "docs:dashboard-links": "node scripts/docs/validate-dashboard-doc-links.mjs",
    "docs:legacy-links": "node scripts/docs/check-legacy-references.mjs",
    "docs:reference": "bun scripts/docs/generate-openapi-reference.mjs --check",
    "sdk:parity": "node scripts/sdk-parity-matrix.mjs",
    "sdk:demos:check": "node scripts/sdk-demo-matrix.mjs --check",
    "sdk:demos:smoke": "node scripts/sdk-demo-matrix.mjs",
    "docs:check": "bun run --filter @tixkit/docs-core build && bun run docs:frontmatter && bun run docs:navigation && bun run docs:links && bun run docs:redirects && bun run docs:readmes && bun run docs:examples && bun run docs:dashboard-links && bun run docs:legacy-links && bun run docs:reference && bun run docs:performance",
    "export:oss": "node scripts/export-oss.mjs --validate-build",
    "guardrails:public-remote": "node scripts/public-remote-guardrails.mjs",
    "validate:completion-backlog": "node scripts/validate-completion-backlog.mjs",
    "validate:final-evidence-checklist": "node scripts/validate-final-evidence-checklist.mjs",
    "validate:high-care-ledger": "node scripts/validate-high-care-ledger.mjs",
    "validate:public-remote-guardrails": "PUBLIC_EXPORT_GITHUB_APP_ID=12345 node scripts/public-remote-guardrails.mjs --print > /tmp/tixkit-public-remote-ruleset.json && node scripts/public-remote-guardrails.mjs --check /tmp/tixkit-public-remote-ruleset.json --workflow .github/workflows/ci.yml --workflow .github/workflows/sdk-release-dry-run.yml --workflow .github/workflows/release-dry-run.yml",
    "validate:public-distribution": "node scripts/validate-public-distribution.mjs",
    "validate:public-repository": "node scripts/rehearse-public-repository.mjs",
    "rehearse:repository-cutover": "node scripts/rehearse-repository-cutover.mjs",
    "rehearse:repository-history-cutover": "node scripts/rehearse-repository-history-cutover.mjs",
    "audit:repository-history": "node scripts/audit-repository-history.mjs",
    "validate:cloud-core-consumer": "node scripts/validate-cloud-core-consumer.mjs",
    "verify:cloud-core-install": "node scripts/verify-cloud-core-install.mjs",
    "build:public-release-manifest": "node scripts/build-public-release-manifest.mjs",
    "publish:public-npm-artifacts": "node scripts/publish-public-npm-artifacts.mjs",
    "publish:public-github-release": "node scripts/publish-public-github-release.mjs",
    "validate:staged-public-release": "node scripts/validate-staged-public-release.mjs",
    "release:public:npm:dry-run": "node scripts/public-npm-release-dry-run.mjs",
    "validate:typescript-version": "node scripts/validate-typescript-version.mjs",
    "validate:user-story-matrix": "node scripts/validate-user-story-matrix.mjs",
    "validate:validation-runbook": "node scripts/validate-validation-runbook.mjs",
    "validate:widget-public": "node scripts/sync-widget-public.mjs --check",
    "validate:embed-fixtures": "bun scripts/generate-embed-fixtures.mjs --check",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "audit": "bun audit",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "bun run test:unit && bun run test:integration",
    "test:scripts": "bun run --filter @tixkit/docs-core build && node --test scripts/__tests__/*.test.mjs && bun run validate:typescript-version && bun run validate:completion-backlog && bun run validate:final-evidence-checklist && bun run validate:high-care-ledger && bun run validate:public-distribution && node scripts/public-npm-release-dry-run.mjs --check && bun run validate:public-remote-guardrails && bun run validate:user-story-matrix && bun run validate:validation-runbook && bun run validate:widget-public && bun run validate:embed-fixtures && node scripts/test-contract-test-consumers.mjs",
    "test:unit": "turbo run test:unit --concurrency=2 && bun run test:scripts",
    "test:integration": "turbo run test:integration --concurrency=1",
    "test:integration:serial": "turbo run test:integration --concurrency=1",
    "test:coverage": "bun run --filter @tixkit/api test:coverage && bun run --filter @tixkit/workflows test:coverage && bun run --filter @tixkit/admin-table-core test:coverage && bun run --filter @tixkit/admin-dashboard test:coverage && bun run --filter @tixkit/checkout test:coverage",
    "test:e2e": "playwright test",
    "test:e2e:settings": "playwright test e2e/settings-gated-actions.spec.ts",
    "test:e2e:checkout-widget": "playwright test e2e/checkout-widget-console.spec.ts",
    "test:e2e:stripe-provider": "E2E_STRIPE_PROVIDER=1 playwright test e2e/checkout-stripe-provider-workflow.spec.ts --project=chromium",
    "test:e2e:live-clerk": "E2E_LIVE_CLERK=1 playwright test e2e/admin-live-clerk-auth.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "db:migrate": "bun run --env-file=.env.local --filter @tixkit/db migrate",
    "db:migrate:mysql": "bun run --env-file=.env.local --filter @tixkit/db migrate:mysql",
    "db:reset": "bun run --env-file=.env.local --filter @tixkit/db reset",
    "db:reset:mysql": "bun run --env-file=.env.local --filter @tixkit/db reset:mysql",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "iac:lint": "helm lint infra/helm/tixkit",
    "iac:template": "helm template tixkit infra/helm/tixkit --namespace tixkit",
    "deploy:check": "infra/scripts/validate-deploy-templates.sh",
    "verify:arc:kata:supply-chain": "infra/ci/scripts/verify-arc-kata.sh --supply-chain-only",
    "release:dry-run": "infra/scripts/release-dry-run.sh",
    "dr:backup:postgres": "infra/scripts/backup-postgres.sh",
    "dr:restore:postgres": "infra/scripts/restore-postgres.sh",
    "dr:backup:mysql": "infra/scripts/backup-mysql.sh",
    "dr:restore:mysql": "infra/scripts/restore-mysql.sh",
    "dr:backup:object-storage": "infra/scripts/backup-object-storage.sh",
    "dr:backup:production": "infra/scripts/production-backup.sh",
    "dr:restore:object-storage": "infra/scripts/restore-object-storage.sh",
    "dr:restore:production": "infra/scripts/production-restore.sh",
    "dr:promote-restored-target": "infra/scripts/promote-restored-target.sh",
    "dr:migration-rehearsal": "infra/scripts/migration-rehearsal.sh",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.0",
    "oxfmt": "0.58.0",
    "oxlint": "^1.73.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-mdx-frontmatter": "5.2.0",
    "turbo": "^2.10.4",
    "typescript": "7.0.2",
    "vitest": "^4.1.10",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.3.0"
  },
  "overrides": {
    "typescript": "7.0.2",
    "postcss": "8.5.15",
    "protobufjs": "7.6.4",
    "js-yaml": "4.3.0",
    "cookie": "1.0.1",
    "@opentelemetry/core": "2.8.0",
    "joi": "17.13.4",
    "tar": "7.5.19",
    "@xmldom/xmldom": "0.8.13",
    "uuid": "11.1.1",
    "@vitejs/plugin-react": "5.2.0",
    "astro": "7.0.3",
    "esbuild": "npm:esbuild@0.28.1",
    "turbo-stream": "3.2.0",
    "estree-util-value-to-estree": "3.5.0",
    "yaml": "2.9.0",
    "@vanilla-extract/integration": "8.0.10"
  },
  "patchedDependencies": {
    "@react-email/editor@1.6.0": "patches/@react-email%2Feditor@1.6.0.patch",
    "next@16.2.10": "patches/next@16.2.10.patch"
  },
  "main": "eslint.config.js",
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nkgotcode/tixkit.git"
  },
  "keywords": [],
  "author": "",
  "bugs": {
    "url": "https://github.com/nkgotcode/tixkit/issues"
  },
  "homepage": "https://github.com/nkgotcode/tixkit#readme"
}
