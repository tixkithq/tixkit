{
  "$schema": "./scripts/performance-capacity.schema.json",
  "schemaVersion": "tixkit-performance-capacity-config-v1",
  "claimScope": "trusted-single-host-capacity-characterization",
  "profiles": [
    {
      "id": "postgresql-trusted-host",
      "runnerLabel": "tixkit-epyc-trusted",
      "database": {
        "engine": "postgresql",
        "image": "postgres:16-alpine@sha256:e013e867e712fec275706a6c51c966f0bb0c93cfa8f51000f85a15f9865a28cb"
      },
      "inventory": 64,
      "concurrencyPoints": [16, 32, 64, 128],
      "samplesPerPoint": 3,
      "timeoutSeconds": 300,
      "saturationP95Ms": 2000,
      "minThroughputGainPercent": 5,
      "command": {
        "executable": "bun",
        "args": [
          "vitest",
          "run",
          "src/__tests__/integration/load-harness.integration.test.ts",
          "-t",
          "prevents oversell under concurrent checkout reservations",
          "--no-file-parallelism",
          "--maxWorkers=1"
        ],
        "env": {
          "CAPACITY_METRICS_PATH": "{metricsPath}",
          "CAPACITY_CHECKOUT_INVENTORY": "{inventory}",
          "CAPACITY_CHECKOUT_CONCURRENCY": "{concurrency}"
        }
      }
    },
    {
      "id": "mysql-trusted-host",
      "runnerLabel": "tixkit-epyc-trusted",
      "database": {
        "engine": "mysql",
        "image": "mysql:8.4@sha256:d36d39a64cd12a5c1cc9e6aa2bfb5f8d4c81a2f6586e0a04a9ae13939db02209"
      },
      "inventory": 64,
      "concurrencyPoints": [16, 32, 64, 128],
      "samplesPerPoint": 3,
      "timeoutSeconds": 300,
      "saturationP95Ms": 2000,
      "minThroughputGainPercent": 5,
      "command": {
        "executable": "bun",
        "args": [
          "vitest",
          "run",
          "src/__tests__/integration/load-harness.integration.test.ts",
          "-t",
          "prevents oversell under concurrent checkout reservations",
          "--no-file-parallelism",
          "--maxWorkers=1"
        ],
        "env": {
          "CAPACITY_METRICS_PATH": "{metricsPath}",
          "CAPACITY_CHECKOUT_INVENTORY": "{inventory}",
          "CAPACITY_CHECKOUT_CONCURRENCY": "{concurrency}"
        }
      }
    }
  ]
}
