{
  "$schema": "./scripts/performance-soak.schema.json",
  "schemaVersion": "tixkit-performance-soak-config-v1",
  "claimScope": "trusted-single-host-continuous-integration-soak",
  "profiles": [
    {
      "id": "postgresql-trusted-host-integration-soak",
      "runnerLabel": "tixkit-epyc-trusted",
      "database": {
        "engine": "postgresql",
        "image": "postgres:16-alpine@sha256:e013e867e712fec275706a6c51c966f0bb0c93cfa8f51000f85a15f9865a28cb"
      },
      "durationSeconds": 14400,
      "minimumIterations": 24,
      "maximumIterations": 4096,
      "maximumLaunchGapSeconds": 5,
      "windowSize": 6,
      "maximumAdverseMedianDriftPercent": 15,
      "iterationTimeoutSeconds": 540,
      "workload": {
        "checkoutCapacity": 25,
        "checkoutConcurrency": 120,
        "scannerConcurrency": 60,
        "streamedExportRows": 2500
      },
      "budgets": "performance-budgets.integration.json",
      "metrics": [
        "checkoutReservationP50Ms",
        "checkoutReservationP95Ms",
        "checkoutReservationQueryCount",
        "checkoutReservationHeapDeltaBytes",
        "scannerCheckInP50Ms",
        "scannerCheckInP95Ms",
        "scannerCheckInQueryCount",
        "scannerCheckInHeapDeltaBytes",
        "exportStreamHeapDeltaBytes"
      ],
      "command": {
        "executable": "bash",
        "args": [
          "-c",
          "cd packages/api && bun vitest run src/__tests__/integration/inventory-concurrency.integration.test.ts src/__tests__/integration/load-harness.integration.test.ts --no-file-parallelism --maxWorkers=1 && cd ../.. && bun run --cwd packages/workflows test:unit -- export-activity.test.ts"
        ],
        "env": { "PERFORMANCE_METRICS_PATH": "{metricsPath}" }
      }
    },
    {
      "id": "mysql-trusted-host-integration-soak",
      "runnerLabel": "tixkit-epyc-trusted",
      "database": {
        "engine": "mysql",
        "image": "mysql:8.4@sha256:d36d39a64cd12a5c1cc9e6aa2bfb5f8d4c81a2f6586e0a04a9ae13939db02209"
      },
      "durationSeconds": 14400,
      "minimumIterations": 24,
      "maximumIterations": 4096,
      "maximumLaunchGapSeconds": 5,
      "windowSize": 6,
      "maximumAdverseMedianDriftPercent": 15,
      "iterationTimeoutSeconds": 540,
      "workload": {
        "checkoutCapacity": 25,
        "checkoutConcurrency": 120,
        "scannerConcurrency": 60,
        "streamedExportRows": 2500
      },
      "budgets": "performance-budgets.integration.json",
      "metrics": [
        "checkoutReservationP50Ms",
        "checkoutReservationP95Ms",
        "checkoutReservationQueryCount",
        "checkoutReservationHeapDeltaBytes",
        "scannerCheckInP50Ms",
        "scannerCheckInP95Ms",
        "scannerCheckInQueryCount",
        "scannerCheckInHeapDeltaBytes",
        "exportStreamHeapDeltaBytes"
      ],
      "command": {
        "executable": "bash",
        "args": [
          "-c",
          "cd packages/api && bun vitest run src/__tests__/integration/inventory-concurrency.integration.test.ts src/__tests__/integration/load-harness.integration.test.ts --no-file-parallelism --maxWorkers=1 && cd ../.. && bun run --cwd packages/workflows test:unit -- export-activity.test.ts"
        ],
        "env": {
          "DB_INTEGRATION_DRIVER": "mysql",
          "PERFORMANCE_METRICS_PATH": "{metricsPath}"
        }
      }
    }
  ]
}
