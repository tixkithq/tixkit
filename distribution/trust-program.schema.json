{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tixkit.com/schemas/trust-program.schema.json",
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "asOf",
    "maxRecordAgeDays",
    "documentation",
    "surfaces",
    "records"
  ],
  "properties": {
    "$schema": { "const": "./trust-program.schema.json" },
    "schemaVersion": { "const": 1 },
    "asOf": {
      "type": "string",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])$"
    },
    "maxRecordAgeDays": { "const": 90 },
    "documentation": { "const": "docs/public/reference/trust.mdx" },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/surface" }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "surface": {
      "type": "object",
      "required": ["path", "recordIds"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "recordIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
        }
      },
      "additionalProperties": false
    },
    "validationCommand": {
      "type": "object",
      "required": ["argv", "cwd", "timeoutMs"],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 2,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[^\\p{Cc};&|><`$]+$"
          }
        },
        "cwd": { "const": "." },
        "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 120000 }
      },
      "additionalProperties": false
    },
    "record": {
      "type": "object",
      "required": ["id", "kind", "scope", "state", "claim", "lastVerified", "publicArtifacts"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "kind": { "enum": ["policy", "service-surface", "evidence"] },
        "scope": { "enum": ["public-core", "self-hosted", "managed-cloud"] },
        "state": {
          "enum": [
            "published",
            "locally-proven",
            "pending-policy-decision",
            "pending-external-proof",
            "not-yet-offered"
          ]
        },
        "claim": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "lastVerified": {
          "type": "string",
          "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])$"
        },
        "publicArtifacts": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "validationCommands": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/validationCommand" }
        },
        "immutableEvidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": ["path", "sha256"],
            "properties": {
              "path": { "type": "string", "pattern": "^artifacts/" },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            },
            "additionalProperties": false
          }
        },
        "blocker": { "type": "string", "minLength": 1, "pattern": "\\S" }
      },
      "allOf": [
        {
          "if": {
            "required": ["state"],
            "properties": { "state": { "enum": ["published", "locally-proven"] } }
          },
          "then": { "properties": { "publicArtifacts": { "type": "array", "minItems": 1 } } }
        },
        {
          "if": {
            "required": ["state"],
            "properties": { "state": { "const": "locally-proven" } }
          },
          "then": {
            "required": ["validationCommands"],
            "properties": { "validationCommands": { "type": "array" } }
          }
        },
        {
          "if": {
            "required": ["state"],
            "properties": {
              "state": { "enum": ["pending-policy-decision", "pending-external-proof"] }
            }
          },
          "then": {
            "required": ["blocker"],
            "properties": { "blocker": { "type": "string" } }
          }
        },
        {
          "if": {
            "required": ["state"],
            "properties": { "state": { "const": "pending-policy-decision" } }
          },
          "then": {
            "properties": {
              "publicArtifacts": { "type": "array", "maxItems": 0 },
              "immutableEvidence": { "type": "array", "maxItems": 0 }
            }
          }
        },
        {
          "if": {
            "required": ["state"],
            "properties": { "state": { "const": "not-yet-offered" } }
          },
          "then": {
            "required": ["blocker"],
            "properties": {
              "blocker": { "type": "string" },
              "scope": { "const": "managed-cloud" },
              "publicArtifacts": { "type": "array", "maxItems": 0 },
              "immutableEvidence": { "type": "array", "maxItems": 0 }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
