{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tixkit.com/schemas/cloud-core-compatibility.schema.json",
  "type": "object",
  "required": ["schemaVersion", "cloudRelease", "core"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "cloudRelease": {
      "type": "object",
      "required": ["version", "sourceCommit", "installations"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "installations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "contentSha256", "entryCount"],
            "properties": {
              "path": { "type": "string", "pattern": "^(?:[^./][^/]*)(?:/[^./][^/]*)*/node_modules$|^node_modules$" },
              "contentSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "entryCount": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "core": { "$ref": "#/$defs/core" }
  },
  "$defs": {
    "core": {
      "type": "object",
      "required": [
        "sourceCommit",
        "sourceTreeSha256",
        "apiVersion",
        "migrationRange",
        "agentProtocol",
        "packages",
        "images",
        "contracts"
      ],
      "properties": {
        "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "sourceTreeSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "apiVersion": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "migrationRange": {
          "type": "object",
          "required": ["minimum", "maximum"],
          "properties": {
            "minimum": { "type": "string", "pattern": "^\\d{4}(?:_\\d+)?$" },
            "maximum": { "type": "string", "pattern": "^\\d{4}(?:_\\d+)?$" }
          },
          "additionalProperties": false
        },
        "agentProtocol": {
          "type": "object",
          "required": ["status", "version"],
          "properties": {
            "status": { "enum": ["unavailable", "supported"] },
            "version": { "type": "string" }
          },
          "additionalProperties": false
        },
        "packages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "version", "integrity", "contentSha256", "fileCount"],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^@?[-a-z0-9]+(?:/[-a-z0-9]+)?$"
              },
              "version": {
                "type": "string",
                "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
              },
              "integrity": {
                "type": "string",
                "pattern": "^sha512-[A-Za-z0-9+/=]+$"
              },
              "contentSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "fileCount": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          }
        },
        "images": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "reference", "digest"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "reference": {
                "type": "string",
                "pattern": "^ghcr\\.io/tixkit/tixkit-(?:api|worker|admin|checkout)@sha256:[a-f0-9]{64}$"
              },
              "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
            },
            "additionalProperties": false
          }
        },
        "contracts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "version", "sha256"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
