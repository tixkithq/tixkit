{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tixkit.com/schemas/hosted-trust-keyring.schema.json",
  "type": "object",
  "required": ["schemaVersion", "purpose", "keys"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "purpose": { "const": "tixkit.hosted-trust-receipt" },
    "keys": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 16,
      "propertyNames": { "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
      "patternProperties": {
        "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$": { "$ref": "#/$defs/key" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "key": {
      "type": "object",
      "required": ["algorithm", "publicKeyPem"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "publicKeyPem": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?![\\s\\S]*PRIVATE KEY)[\\s\\S]+$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
