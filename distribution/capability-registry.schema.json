{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tixkit.com/schemas/capability-registry.schema.json",
  "type": "object",
  "required": ["$schema", "schemaVersion", "documentation", "capabilities"],
  "properties": {
    "$schema": { "const": "./capability-registry.schema.json" },
    "schemaVersion": { "const": 2 },
    "documentation": { "const": "docs/public/reference/capabilities-and-integrations.mdx" },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/capability" }
    }
  },
  "$defs": {
    "availability": {
      "type": "object",
      "required": ["cloud", "platformApi", "selfHosted"],
      "properties": {
        "cloud": { "enum": ["available", "private-beta", "planned", "unavailable"] },
        "platformApi": { "enum": ["available", "private-beta", "planned", "unavailable"] },
        "selfHosted": { "enum": ["available", "private-beta", "planned", "unavailable"] }
      },
      "additionalProperties": false
    },
    "boundary": {
      "type": "object",
      "required": ["path", "symbols"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?:packages|apps|docs|scripts|distribution)/",
          "minLength": 1
        },
        "symbols": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$" }
        }
      },
      "additionalProperties": false
    },
    "extensionContract": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["versioned", "not-yet-versioned"] },
        "version": { "const": "tixkit.messaging-provider/v1" },
        "packageBoundary": {
          "type": "object",
          "required": ["packageName", "exportPath", "symbol"],
          "properties": {
            "packageName": { "const": "@tixkit/domain" },
            "exportPath": { "const": "./messaging" },
            "symbol": { "const": "registerMessagingProviderExtension" }
          },
          "additionalProperties": false
        },
        "missingContractReason": { "type": "string", "minLength": 1, "pattern": "\\S" }
      },
      "additionalProperties": false
    },
    "obligations": {
      "type": "object",
      "required": [
        "credentialCustody",
        "plaintextCredentialsPortable",
        "portability",
        "destinationRebinding",
        "consent",
        "suppression",
        "webhooks",
        "retries",
        "idempotency",
        "audit"
      ],
      "properties": {
        "credentialCustody": {
          "enum": ["operator", "managed-cloud", "caller-or-operator", "none"]
        },
        "plaintextCredentialsPortable": { "const": false },
        "portability": { "enum": ["configuration-only", "contract-metadata", "not-applicable"] },
        "destinationRebinding": { "enum": ["required", "not-applicable"] },
        "consent": { "enum": ["required", "not-applicable"] },
        "suppression": { "enum": ["required", "not-applicable"] },
        "webhooks": { "enum": ["required", "not-applicable"] },
        "retries": { "enum": ["required", "not-applicable"] },
        "idempotency": { "enum": ["required", "not-applicable"] },
        "audit": { "const": "required" }
      },
      "additionalProperties": false
    },
    "capability": {
      "type": "object",
      "required": [
        "id",
        "name",
        "classification",
        "lifecycle",
        "availability",
        "extensionContract",
        "obligations",
        "notes"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 },
        "classification": {
          "enum": [
            "shared-core",
            "public-provider-adapter",
            "managed-provider-service",
            "managed-intelligence"
          ]
        },
        "lifecycle": { "enum": ["stable", "private-beta", "planned"] },
        "availability": { "$ref": "#/$defs/availability" },
        "extensionContract": { "$ref": "#/$defs/extensionContract" },
        "publicBoundary": { "$ref": "#/$defs/boundary" },
        "obligations": { "$ref": "#/$defs/obligations" },
        "notes": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "extensionContract": {
                "type": "object",
                "properties": { "status": { "const": "versioned" } },
                "required": ["status"]
              }
            },
            "required": ["extensionContract"]
          },
          "then": {
            "required": ["publicBoundary"],
            "properties": {
              "publicBoundary": { "$ref": "#/$defs/boundary" },
              "extensionContract": {
                "type": "object",
                "required": ["status", "version", "packageBoundary"],
                "properties": {
                  "status": {},
                  "version": {},
                  "packageBoundary": {},
                  "missingContractReason": {}
                },
                "not": {
                  "type": "object",
                  "properties": {
                    "missingContractReason": { "type": "string" }
                  },
                  "required": ["missingContractReason"]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "extensionContract": {
                "type": "object",
                "properties": { "status": { "const": "not-yet-versioned" } },
                "required": ["status"]
              }
            },
            "required": ["extensionContract"]
          },
          "then": {
            "properties": {
              "extensionContract": {
                "type": "object",
                "properties": {
                  "missingContractReason": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                },
                "required": ["missingContractReason"],
                "not": {
                  "anyOf": [
                    { "properties": { "version": {} }, "required": ["version"] },
                    {
                      "properties": { "packageBoundary": {} },
                      "required": ["packageBoundary"]
                    }
                  ]
                }
              },
              "publicBoundary": false,
              "lifecycle": { "const": "planned" },
              "availability": {
                "type": "object",
                "properties": {
                  "cloud": { "not": { "const": "available" } },
                  "platformApi": { "not": { "const": "available" } },
                  "selfHosted": { "const": "unavailable" }
                }
              }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
