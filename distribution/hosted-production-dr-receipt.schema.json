{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tixkit.com/schemas/hosted-production-dr-receipt.schema.json",
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "kind",
    "trustRecordId",
    "scope",
    "source",
    "workflow",
    "artifact",
    "validation",
    "observedAt",
    "signature"
  ],
  "properties": {
    "$schema": {
      "const": "https://tixkit.com/schemas/hosted-production-dr-receipt.schema.json"
    },
    "schemaVersion": { "const": 1 },
    "kind": { "const": "tixkit.hosted-production-dr-receipt" },
    "trustRecordId": { "const": "dr-evidence" },
    "scope": { "const": "self-hosted" },
    "source": {
      "type": "object",
      "required": ["repository", "commit", "tree"],
      "properties": {
        "repository": { "const": "tixkit/tixkit" },
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "tree": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      },
      "additionalProperties": false
    },
    "workflow": {
      "type": "object",
      "required": ["repository", "path", "runId", "attempt", "url"],
      "properties": {
        "repository": { "const": "tixkit/tixkit" },
        "path": { "const": ".github/workflows/production-dr.yml" },
        "runId": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
        "attempt": { "type": "integer", "minimum": 1, "maximum": 100 },
        "url": {
          "type": "string",
          "pattern": "^https://github\\.com/tixkit/tixkit/actions/runs/[1-9][0-9]{0,19}$"
        }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": ["kind", "sizeBytes", "sha256"],
      "properties": {
        "kind": { "const": "production-dr" },
        "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 67108864 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "required": ["validator", "version", "outcome", "expectationsSha256"],
      "properties": {
        "validator": {
          "const": "scripts/verify-production-rehearsal.mjs#verifyProductionRehearsal"
        },
        "version": { "const": 1 },
        "outcome": { "const": "passed" },
        "expectationsSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "observedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "signature": {
      "type": "object",
      "required": ["algorithm", "keyId", "value"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "keyId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
        "value": { "type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
