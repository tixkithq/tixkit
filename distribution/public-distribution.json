      { "path": "packages/openapi", "ecosystem": "npm" },
      { "path": "packages/sdk-android", "ecosystem": "maven" },
      { "path": "packages/sdk-astro", "ecosystem": "npm" },
      { "path": "packages/sdk-flutter", "ecosystem": "pub" },
      { "path": "packages/sdk-go", "ecosystem": "go" },
      { "path": "packages/sdk-ios", "ecosystem": "swift" },
      { "path": "packages/sdk-js", "ecosystem": "npm" },
      { "path": "packages/sdk-next", "ecosystem": "npm" },
