      { "name": "api", "dockerfile": "Dockerfile.api" },
      { "name": "worker", "dockerfile": "Dockerfile.worker" },
      { "name": "admin", "dockerfile": "Dockerfile.admin" },
      { "name": "checkout", "dockerfile": "Dockerfile.checkout" }
    ],
    "contracts": [
      "artifacts/api/2026-01-01",
      "distribution/cloud-core-compatibility.schema.json",
      "distribution/public-release-manifest.schema.json",
      "packages/embed-core/schemas/checkout-message.schema.json",
      "packages/embed-core/schemas/lifecycle.schema.json"
    ],
    "selfHostedProfiles": {
      "compact": "infra/compact/compose.yml",
      "production": "infra/helm/tixkit"
    }
  },
  "forbiddenDependencies": ["tixkit-cloud", "@tixkit-cloud", "@tixkit/managed"]
