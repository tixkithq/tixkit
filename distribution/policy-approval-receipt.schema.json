{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tixkit.com/schemas/policy-approval-receipt.schema.json",
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "kind",
    "policyRecordId",
    "source",
    "decision",
    "currentRecordSha256",
    "proposedRecordSha256",
    "artifacts",
    "signatures"
  ],
  "properties": {
    "$schema": { "const": "https://tixkit.com/schemas/policy-approval-receipt.schema.json" },
    "schemaVersion": { "const": 1 },
    "kind": { "const": "tixkit.policy-approval-receipt" },
    "policyRecordId": {
      "enum": [
        "data-residency",
        "managed-sla",
        "privacy-roles",
        "subprocessors",
        "version-lifecycle",
        "vulnerability-response"
      ]
    },
    "source": {
      "type": "object",
      "required": ["repository", "commit", "tree"],
      "properties": {
        "repository": { "const": "tixkithq/tixkit" },
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "tree": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      },
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "required": ["id", "version", "decidedAt", "publicationAt"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
        "version": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "decidedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "publicationAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        }
      },
      "additionalProperties": false
    },
    "currentRecordSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "proposedRecordSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[A-Za-z0-9._/-]+$"
          },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "signatures": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["algorithm", "keyId", "role", "value"],
        "properties": {
          "algorithm": { "const": "Ed25519" },
          "keyId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
          "role": {
            "enum": [
              "legal",
              "maintainer",
              "operations",
              "privacy",
              "product",
              "release",
              "security"
            ]
          },
          "value": { "type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
