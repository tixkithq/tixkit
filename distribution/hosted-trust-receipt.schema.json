{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tixkit.com/schemas/hosted-trust-receipt.schema.json",
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "kind",
    "trustRecordId",
    "scope",
    "source",
    "workflow",
    "artifact",
    "validation",
    "observedAt",
    "signature"
  ],
  "properties": {
    "$schema": { "const": "https://tixkit.com/schemas/hosted-trust-receipt.schema.json" },
    "schemaVersion": { "const": 1 },
    "kind": { "const": "tixkit.hosted-trust-receipt" },
    "trustRecordId": { "enum": ["dr-evidence", "performance-evidence"] },
    "scope": { "enum": ["public-core", "self-hosted"] },
    "source": {
      "type": "object",
      "required": ["repository", "commit", "tree"],
      "properties": {
        "repository": { "const": "tixkit/tixkit" },
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "tree": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      },
      "additionalProperties": false
    },
    "workflow": {
      "type": "object",
      "required": ["repository", "path", "runId", "attempt", "url"],
      "properties": {
        "repository": { "const": "tixkit/tixkit" },
        "path": {
          "enum": [
            ".github/workflows/performance-capacity.yml",
            ".github/workflows/performance-profile-capacity.yml",
            ".github/workflows/performance-fault.yml",
            ".github/workflows/performance-nightly.yml",
            ".github/workflows/performance-soak.yml",
            ".github/workflows/performance-temporal-fault.yml"
          ]
        },
        "runId": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
        "attempt": { "type": "integer", "minimum": 1 },
        "url": {
          "type": "string",
          "pattern": "^https://github\\.com/tixkit/tixkit/actions/runs/[1-9][0-9]{0,19}$"
        }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": ["kind", "sizeBytes", "sha256"],
      "properties": {
        "kind": {
          "enum": [
            "performance-capacity",
            "performance-profile-capacity",
            "performance-fault",
            "performance-soak",
            "performance-temporal-fault",
            "performance-trends"
          ]
        },
        "sizeBytes": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "required": ["validator", "version", "outcome"],
      "properties": {
        "validator": {
          "enum": [
            "scripts/performance-capacity.mjs#validateCapacityEvidence",
            "scripts/performance-profile-capacity.mjs#verifySupportedProfileCapacityEvidence",
            "scripts/performance-fault.mjs#validateFaultEvidence",
            "scripts/performance-soak.mjs#validateSoakEvidenceDirectory",
            "scripts/performance-temporal-fault.mjs#validateTemporalFaultEvidence",
            "scripts/performance-trends.mjs#validateTrendEvidence"
          ]
        },
        "version": { "const": 1 },
        "outcome": { "const": "passed" }
      },
      "additionalProperties": false
    },
    "observedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "signature": {
      "type": "object",
      "required": ["algorithm", "keyId", "value"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "keyId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
        "value": { "type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
