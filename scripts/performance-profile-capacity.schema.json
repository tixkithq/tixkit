{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tixkit.com/performance/supported-profile-capacity-v3.json",
  "oneOf": [
    { "$ref": "#/$defs/config" },
    { "$ref": "#/$defs/evidence" },
    { "$ref": "#/$defs/failureEvidence" }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "gitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "files", "manifestSha256"],
      "properties": {
        "kind": { "enum": ["compact-compose", "production-helm"] },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:infra/compact|infra/helm/tixkit)/"
          }
        },
        "manifestSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "topology"],
      "properties": {
        "engine": { "enum": ["postgresql", "mysql"] },
        "topology": {
          "enum": ["bundled-single-instance", "external-high-availability"]
        }
      }
    },
    "componentResources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replicas", "cpuQuotaMillis", "memoryLimitMiB"],
      "properties": {
        "replicas": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "cpuQuotaMillis": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "memoryLimitMiB": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api", "worker"],
      "properties": {
        "api": { "$ref": "#/$defs/componentResources" },
        "worker": { "$ref": "#/$defs/componentResources" }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "inventory",
        "concurrencyPoints",
        "samplesPerPoint",
        "minimumDurationSeconds",
        "maximumP95Ms",
        "requireZeroPlatformFailures"
      ],
      "properties": {
        "id": { "const": "checkout-reservation-v1" },
        "inventory": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "concurrencyPoints": {
          "type": "array",
          "minItems": 3,
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 1000000 }
        },
        "samplesPerPoint": { "type": "integer", "minimum": 3, "maximum": 100 },
        "minimumDurationSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 86400
        },
        "maximumP95Ms": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 60000
        },
        "requireZeroPlatformFailures": { "const": true }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "deployment", "database", "resources", "workload"],
      "properties": {
        "id": { "enum": ["compact", "production"] },
        "deployment": { "$ref": "#/$defs/deployment" },
        "database": { "$ref": "#/$defs/database" },
        "resources": { "$ref": "#/$defs/resources" },
        "workload": { "$ref": "#/$defs/workload" }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$schema", "schemaVersion", "claimScope", "denials", "profiles"],
      "properties": {
        "$schema": {
          "const": "./scripts/performance-profile-capacity.schema.json"
        },
        "schemaVersion": {
          "const": "tixkit-supported-profile-capacity-config-v2"
        },
        "claimScope": { "const": "supported-profile-capacity-eligibility" },
        "denials": {
          "const": [
            "capacity proof without profile-scoped hosted evidence",
            "Cloud capacity",
            "SLA or SLO attainment",
            "soak stability",
            "fault tolerance"
          ]
        },
        "profiles": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/profile" }
        }
      }
    },
    "sampleMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempts",
        "rounds",
        "reservationActiveLoadMs",
        "successes",
        "expectedInventoryDeclines",
        "platformFailures",
        "successfulReservationP95Ms",
        "finalHeld"
      ],
      "properties": {
        "attempts": { "type": "integer", "minimum": 1 },
        "rounds": { "type": "integer", "minimum": 1 },
        "reservationActiveLoadMs": { "type": "integer", "minimum": 0 },
        "successes": { "type": "integer", "minimum": 0 },
        "expectedInventoryDeclines": { "type": "integer", "minimum": 0 },
        "platformFailures": { "type": "integer", "minimum": 0 },
        "successfulReservationP95Ms": { "type": "number", "minimum": 0 },
        "finalHeld": { "type": "integer", "minimum": 0 }
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "concurrency",
        "sample",
        "startedAt",
        "completedAt",
        "elapsedMs",
        "runtime",
        "fixtureSha256",
        "rawSha256",
        "metrics"
      ],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "concurrency": { "type": "integer", "minimum": 1 },
        "sample": { "type": "integer", "minimum": 1 },
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "elapsedMs": { "type": "integer", "minimum": 1 },
        "runtime": { "$ref": "#/$defs/runtime" },
        "fixtureSha256": { "$ref": "#/$defs/sha256" },
        "rawSha256": { "$ref": "#/$defs/sha256" },
        "metrics": { "$ref": "#/$defs/sampleMetrics" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "deploymentManifestSha256",
        "database",
        "api",
        "worker",
        "topologyFingerprint",
        "targetBinding"
      ],
      "properties": {
        "profile": { "enum": ["compact", "production"] },
        "deploymentManifestSha256": { "$ref": "#/$defs/sha256" },
        "database": { "$ref": "#/$defs/database" },
        "api": { "$ref": "#/$defs/runtimeComponent" },
        "worker": { "$ref": "#/$defs/runtimeComponent" },
        "topologyFingerprint": { "$ref": "#/$defs/topologyFingerprint" },
        "targetBinding": { "$ref": "#/$defs/targetBinding" }
      }
    },
    "topologyFingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sha256"],
      "properties": {
        "version": { "const": "tixkit-supported-profile-topology-v1" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "targetBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transport",
        "apiImageDigest",
        "apiOriginSha256",
        "fixtureDeploymentSha256",
        "fixtureIdentityPublicKeySha256",
        "fixtureOriginSha256",
        "fixtureServiceArtifactSha256"
      ],
      "properties": {
        "transport": { "enum": ["https", "compact-loopback-http"] },
        "apiImageDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "apiOriginSha256": { "$ref": "#/$defs/sha256" },
        "fixtureDeploymentSha256": { "$ref": "#/$defs/sha256" },
        "fixtureIdentityPublicKeySha256": { "$ref": "#/$defs/sha256" },
        "fixtureOriginSha256": { "$ref": "#/$defs/sha256" },
        "fixtureServiceArtifactSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "runtimeComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replicas", "cpuQuotaMillis", "memoryLimitMiB", "imageDigest"],
      "properties": {
        "replicas": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "cpuQuotaMillis": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "memoryLimitMiB": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "imageDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "claimScope",
        "denials",
        "integrityModel",
        "sourceCommit",
        "gitTree",
        "configSha256",
        "releaseManifestSha256",
        "images",
        "profile",
        "deploymentManifestSha256",
        "database",
        "topologyFingerprint",
        "targetBinding",
        "resourcesSha256",
        "workloadSha256",
        "startedAt",
        "completedAt",
        "durationSeconds",
        "activeLoadSeconds",
        "samples",
        "capacityAssessment",
        "capacityClaim",
        "evidenceSha256"
      ],
      "properties": {
        "schemaVersion": {
          "const": "tixkit-supported-profile-capacity-evidence-v3"
        },
        "claimScope": {
          "const": "supported-profile-capacity-characterization"
        },
        "denials": {
          "const": [
            "Cloud capacity",
            "SLA or SLO attainment",
            "soak stability",
            "fault tolerance",
            "worker, frontend, provider, Temporal, Redis, object-storage or host capacity",
            "relational database and dependency capacity are not independently characterized"
          ]
        },
        "integrityModel": { "const": "checksums-plus-hosted-Ed25519-receipt" },
        "sourceCommit": { "$ref": "#/$defs/gitSha" },
        "gitTree": { "$ref": "#/$defs/gitSha" },
        "configSha256": { "$ref": "#/$defs/sha256" },
        "releaseManifestSha256": { "$ref": "#/$defs/sha256" },
        "images": {
          "type": "object",
          "additionalProperties": false,
          "required": ["api", "worker"],
          "properties": {
            "api": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
            "worker": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
          }
        },
        "profile": { "enum": ["compact", "production"] },
        "deploymentManifestSha256": { "$ref": "#/$defs/sha256" },
        "database": { "$ref": "#/$defs/database" },
        "topologyFingerprint": { "$ref": "#/$defs/topologyFingerprint" },
        "targetBinding": { "$ref": "#/$defs/targetBinding" },
        "resourcesSha256": { "$ref": "#/$defs/sha256" },
        "workloadSha256": { "$ref": "#/$defs/sha256" },
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "durationSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 604800
        },
        "activeLoadSeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 604800
        },
        "samples": {
          "type": "array",
          "minItems": 9,
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/sample" }
        },
        "capacityAssessment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason",
            "evaluatedConcurrencyPoints",
            "objectiveViolatingConcurrency"
          ],
          "properties": {
            "status": { "enum": ["claim", "no-claim"] },
            "reason": {
              "enum": [
                "saturation-observed",
                "first-point-objective-failed",
                "saturation-not-observed"
              ]
            },
            "evaluatedConcurrencyPoints": {
              "type": "array",
              "minItems": 3,
              "maxItems": 100,
              "uniqueItems": true,
              "items": { "type": "integer", "minimum": 1, "maximum": 1000000 }
            },
            "objectiveViolatingConcurrency": {
              "type": ["integer", "null"],
              "minimum": 1,
              "maximum": 1000000
            }
          }
        },
        "capacityClaim": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "surface",
                "dependencyScope",
                "hostCapacity",
                "maxPublishableConcurrency",
                "saturationObservedAtConcurrency"
              ],
              "properties": {
                "surface": { "const": "api-checkout-reservation" },
                "dependencyScope": {
                  "const": "runtime-topology-bound-dependencies-not-independently-characterized"
                },
                "hostCapacity": { "const": "not-characterized" },
                "maxPublishableConcurrency": {
                  "type": "integer",
                  "minimum": 1
                },
                "saturationObservedAtConcurrency": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          ]
        },
        "evidenceSha256": { "$ref": "#/$defs/sha256" }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "capacityAssessment": {
                "type": "object",
                "properties": { "status": { "const": "claim" } }
              }
            }
          },
          "then": {
            "properties": {
              "capacityAssessment": {
                "type": "object",
                "properties": {
                  "reason": { "const": "saturation-observed" },
                  "objectiveViolatingConcurrency": { "type": "integer" }
                }
              },
              "capacityClaim": { "type": "object" }
            }
          },
          "else": {
            "properties": {
              "capacityAssessment": {
                "type": "object",
                "properties": {
                  "reason": {
                    "enum": ["first-point-objective-failed", "saturation-not-observed"]
                  }
                }
              },
              "capacityClaim": { "type": "null" }
            }
          }
        }
      ]
    },
    "failureEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "claimScope",
        "denials",
        "integrityModel",
        "outcome",
        "reason",
        "sourceCommit",
        "gitTree",
        "configSha256",
        "releaseManifestSha256",
        "images",
        "profile",
        "deploymentManifestSha256",
        "database",
        "topologyFingerprint",
        "targetBinding",
        "runtime",
        "proofs",
        "samples",
        "errorSha256",
        "evidenceSha256"
      ],
      "properties": {
        "schemaVersion": {
          "const": "tixkit-supported-profile-capacity-evidence-v3"
        },
        "claimScope": {
          "const": "supported-profile-capacity-characterization"
        },
        "denials": {
          "const": [
            "Cloud capacity",
            "SLA or SLO attainment",
            "soak stability",
            "fault tolerance",
            "worker, frontend, provider, Temporal, Redis, object-storage or host capacity",
            "relational database and dependency capacity are not independently characterized"
          ]
        },
        "integrityModel": { "const": "checksums-plus-hosted-Ed25519-receipt" },
        "outcome": { "const": "failure" },
        "reason": {
          "enum": ["workload-execution-failed", "evidence-validation-failed"]
        },
        "sourceCommit": { "$ref": "#/$defs/gitSha" },
        "gitTree": { "$ref": "#/$defs/gitSha" },
        "configSha256": { "$ref": "#/$defs/sha256" },
        "releaseManifestSha256": { "$ref": "#/$defs/sha256" },
        "images": {
          "type": "object",
          "additionalProperties": false,
          "required": ["api", "worker"],
          "properties": {
            "api": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
            "worker": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
          }
        },
        "profile": { "enum": ["compact", "production"] },
        "deploymentManifestSha256": { "$ref": "#/$defs/sha256" },
        "database": { "$ref": "#/$defs/database" },
        "topologyFingerprint": { "$ref": "#/$defs/topologyFingerprint" },
        "targetBinding": { "$ref": "#/$defs/targetBinding" },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["runtimeSha256", "runtimeDescriptorSha256"],
          "properties": {
            "runtimeSha256": { "$ref": "#/$defs/sha256" },
            "runtimeDescriptorSha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "proofs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{0,127}\\.json$"
              },
              "sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        },
        "samples": {
          "type": "array",
          "minItems": 0,
          "maxItems": 10000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sequence", "rawSha256"],
            "properties": {
              "sequence": { "type": "integer", "minimum": 1 },
              "rawSha256": { "$ref": "#/$defs/sha256" }
            }
          }
        },
        "errorSha256": { "$ref": "#/$defs/sha256" },
        "evidenceSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
