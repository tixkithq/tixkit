{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tixkit.com/performance/supported-profile-capacity-v1.json",
  "oneOf": [{ "$ref": "#/$defs/config" }, { "$ref": "#/$defs/evidence" }],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "gitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "files", "manifestSha256"],
      "properties": {
        "kind": { "enum": ["compact-compose", "production-helm"] },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(?:infra/compact|infra/helm/tixkit)/" }
        },
        "manifestSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "topology"],
      "properties": {
        "engine": { "enum": ["postgresql", "mysql"] },
        "topology": { "enum": ["bundled-single-instance", "external-high-availability"] }
      }
    },
    "componentResources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replicas", "cpuQuotaMillis", "memoryLimitMiB"],
      "properties": {
        "replicas": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "cpuQuotaMillis": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "memoryLimitMiB": { "type": "integer", "minimum": 1, "maximum": 1000000 }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api", "worker"],
      "properties": {
        "api": { "$ref": "#/$defs/componentResources" },
        "worker": { "$ref": "#/$defs/componentResources" }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "inventory",
        "concurrencyPoints",
        "samplesPerPoint",
        "minimumDurationSeconds",
        "maximumP95Ms",
        "requireZeroPlatformFailures"
      ],
      "properties": {
        "id": { "const": "checkout-reservation-v1" },
        "inventory": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "concurrencyPoints": {
          "type": "array",
          "minItems": 3,
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 1000000 }
        },
        "samplesPerPoint": { "type": "integer", "minimum": 3, "maximum": 100 },
        "minimumDurationSeconds": { "type": "integer", "minimum": 60, "maximum": 86400 },
        "maximumP95Ms": { "type": "number", "exclusiveMinimum": 0, "maximum": 60000 },
        "requireZeroPlatformFailures": { "const": true }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "deployment", "database", "resources", "workload"],
      "properties": {
        "id": { "enum": ["compact", "production"] },
        "deployment": { "$ref": "#/$defs/deployment" },
        "database": { "$ref": "#/$defs/database" },
        "resources": { "$ref": "#/$defs/resources" },
        "workload": { "$ref": "#/$defs/workload" }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$schema", "schemaVersion", "claimScope", "denials", "profiles"],
      "properties": {
        "$schema": { "const": "./scripts/performance-profile-capacity.schema.json" },
        "schemaVersion": { "const": "tixkit-supported-profile-capacity-config-v1" },
        "claimScope": { "const": "supported-profile-capacity-eligibility" },
        "denials": {
          "const": [
            "capacity proof without profile-scoped hosted evidence",
            "Cloud capacity",
            "SLA or SLO attainment",
            "soak stability",
            "fault tolerance"
          ]
        },
        "profiles": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/profile" }
        }
      }
    },
    "sampleMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempts",
        "successes",
        "expectedInventoryDeclines",
        "platformFailures",
        "successfulReservationP95Ms"
      ],
      "properties": {
        "attempts": { "type": "integer", "minimum": 1 },
        "successes": { "type": "integer", "minimum": 0 },
        "expectedInventoryDeclines": { "type": "integer", "minimum": 0 },
        "platformFailures": { "type": "integer", "minimum": 0 },
        "successfulReservationP95Ms": { "type": "number", "minimum": 0 }
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "concurrency",
        "sample",
        "startedAt",
        "completedAt",
        "elapsedMs",
        "runtime",
        "rawSha256",
        "metrics"
      ],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "concurrency": { "type": "integer", "minimum": 1 },
        "sample": { "type": "integer", "minimum": 1 },
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "elapsedMs": { "type": "integer", "minimum": 1 },
        "runtime": { "$ref": "#/$defs/runtime" },
        "rawSha256": { "$ref": "#/$defs/sha256" },
        "metrics": { "$ref": "#/$defs/sampleMetrics" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "deploymentManifestSha256", "database", "api", "worker"],
      "properties": {
        "profile": { "enum": ["compact", "production"] },
        "deploymentManifestSha256": { "$ref": "#/$defs/sha256" },
        "database": { "$ref": "#/$defs/database" },
        "api": { "$ref": "#/$defs/runtimeComponent" },
        "worker": { "$ref": "#/$defs/runtimeComponent" }
      }
    },
    "runtimeComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replicas", "cpuQuotaMillis", "memoryLimitMiB", "imageDigest"],
      "properties": {
        "replicas": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "cpuQuotaMillis": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "memoryLimitMiB": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "imageDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "claimScope",
        "denials",
        "integrityModel",
        "sourceCommit",
        "gitTree",
        "configSha256",
        "releaseManifestSha256",
        "images",
        "profile",
        "deploymentManifestSha256",
        "database",
        "resourcesSha256",
        "workloadSha256",
        "startedAt",
        "completedAt",
        "durationSeconds",
        "samples",
        "capacityClaim",
        "evidenceSha256"
      ],
      "properties": {
        "schemaVersion": { "const": "tixkit-supported-profile-capacity-evidence-v1" },
        "claimScope": { "const": "supported-profile-capacity-characterization" },
        "denials": {
          "const": ["Cloud capacity", "SLA or SLO attainment", "soak stability", "fault tolerance"]
        },
        "integrityModel": { "const": "checksums-plus-hosted-Ed25519-receipt" },
        "sourceCommit": { "$ref": "#/$defs/gitSha" },
        "gitTree": { "$ref": "#/$defs/gitSha" },
        "configSha256": { "$ref": "#/$defs/sha256" },
        "releaseManifestSha256": { "$ref": "#/$defs/sha256" },
        "images": {
          "type": "object",
          "additionalProperties": false,
          "required": ["api", "worker"],
          "properties": {
            "api": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
            "worker": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
          }
        },
        "profile": { "enum": ["compact", "production"] },
        "deploymentManifestSha256": { "$ref": "#/$defs/sha256" },
        "database": { "$ref": "#/$defs/database" },
        "resourcesSha256": { "$ref": "#/$defs/sha256" },
        "workloadSha256": { "$ref": "#/$defs/sha256" },
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "durationSeconds": { "type": "integer", "minimum": 1, "maximum": 604800 },
        "samples": {
          "type": "array",
          "minItems": 9,
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/sample" }
        },
        "capacityClaim": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxPublishableConcurrency", "saturationObservedAtConcurrency"],
          "properties": {
            "maxPublishableConcurrency": { "type": "integer", "minimum": 1 },
            "saturationObservedAtConcurrency": { "type": "integer", "minimum": 1 }
          }
        },
        "evidenceSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
