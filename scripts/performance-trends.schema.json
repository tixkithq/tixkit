{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tixkit.com/performance/trends-v1.json",
  "title": "Tixkit cross-revision performance trends",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "claimScope",
    "workflowPath",
    "artifactPrefix",
    "scenarioConfig",
    "maximumRuns",
    "retentionDays",
    "maximumGapHours"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "tixkit-performance-trends-config-v1" },
    "claimScope": { "const": "trusted-single-host-cross-revision-trend" },
    "workflowPath": { "const": ".github/workflows/performance-nightly.yml" },
    "artifactPrefix": { "const": "nightly-performance-" },
    "scenarioConfig": { "const": "performance-scenarios.nightly.json" },
    "maximumRuns": { "type": "integer", "minimum": 2, "maximum": 50 },
    "retentionDays": { "type": "integer", "minimum": 7, "maximum": 90 },
    "maximumGapHours": { "type": "integer", "minimum": 24, "maximum": 168 }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "gitSha": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "runs"],
      "properties": {
        "schemaVersion": { "const": "tixkit-performance-trend-history-v1" },
        "runs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": { "$ref": "#/$defs/historyRun" }
        }
      }
    },
    "historyRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "runId",
        "runAttempt",
        "runUrl",
        "workflowPath",
        "event",
        "headBranch",
        "headSha",
        "status",
        "conclusion",
        "createdAt",
        "updatedAt",
        "artifactName",
        "evidenceFile",
        "scenarioRunFile",
        "rawSamples"
      ],
      "properties": {
        "source": { "enum": ["retained", "current"] },
        "runId": { "type": "integer", "minimum": 1 },
        "runAttempt": { "type": "integer", "minimum": 1 },
        "runUrl": { "type": "string", "format": "uri" },
        "workflowPath": { "type": "string", "minLength": 1 },
        "event": { "enum": ["schedule", "workflow_dispatch"] },
        "headBranch": { "type": "string", "minLength": 1 },
        "headSha": { "$ref": "#/$defs/gitSha" },
        "status": { "enum": ["completed", "in_progress"] },
        "conclusion": { "type": ["string", "null"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "artifactName": { "type": "string", "minLength": 1 },
        "evidenceFile": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}\\.json$"
        },
        "scenarioRunFile": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}\\.json$"
        },
        "baselineFile": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}\\.json$"
        },
        "rawSamples": {
          "type": "array",
          "minItems": 3,
          "maxItems": 144,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "metricsFile", "sampleFile"],
            "properties": {
              "name": { "type": "string", "pattern": "^sample-[1-9][0-9]*\\.json$" },
              "metricsFile": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}\\.json$"
              },
              "sampleFile": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}\\.json$"
              }
            }
          }
        }
      }
    },
    "trend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "claimScope",
        "status",
        "candidateReason",
        "identity",
        "window",
        "metricSet",
        "metricContracts",
        "runs",
        "trendSha256"
      ],
      "properties": {
        "schemaVersion": { "const": "tixkit-performance-trend-v1" },
        "claimScope": { "const": "trusted-single-host-cross-revision-trend" },
        "status": { "enum": ["candidate", "passing", "regressed"] },
        "candidateReason": { "type": ["string", "null"] },
        "identity": { "$ref": "#/$defs/trendIdentity" },
        "window": { "$ref": "#/$defs/trendWindow" },
        "metricSet": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "metricContracts": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9]*$" },
          "additionalProperties": { "$ref": "#/$defs/metricContract" }
        },
        "runs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/trendRun" } },
        "trendSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "trendIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "defaultBranch",
        "workflowPath",
        "artifactName",
        "scenarioId",
        "profile",
        "runnerLabel",
        "database",
        "workloadSha256",
        "scenarioConfigSha256",
        "scenarioSha256",
        "budgetSha256",
        "maxRegressionPercent"
      ],
      "properties": {
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "defaultBranch": { "type": "string", "minLength": 1 },
        "workflowPath": { "const": ".github/workflows/performance-nightly.yml" },
        "artifactName": {
          "type": "string",
          "pattern": "^nightly-performance-[a-z0-9][-a-z0-9]{0,62}$"
        },
        "scenarioId": { "type": "string", "pattern": "^[a-z0-9][-a-z0-9]{0,62}$" },
        "profile": { "type": "string", "minLength": 1 },
        "runnerLabel": { "type": "string", "minLength": 1 },
        "database": {
          "type": "object",
          "additionalProperties": false,
          "required": ["engine", "version"],
          "properties": {
            "engine": { "enum": ["postgresql", "mysql"] },
            "version": { "type": "string", "minLength": 1 }
          }
        },
        "workloadSha256": { "$ref": "#/$defs/sha256" },
        "scenarioConfigSha256": { "$ref": "#/$defs/sha256" },
        "scenarioSha256": { "$ref": "#/$defs/sha256" },
        "budgetSha256": { "$ref": "#/$defs/sha256" },
        "maxRegressionPercent": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "trendWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generatedAt",
        "retentionDays",
        "maximumRuns",
        "maximumGapHours",
        "runCount",
        "firstRunAt",
        "lastRunAt"
      ],
      "properties": {
        "generatedAt": { "type": "string", "format": "date-time" },
        "retentionDays": { "type": "integer", "minimum": 7, "maximum": 90 },
        "maximumRuns": { "type": "integer", "minimum": 2, "maximum": 50 },
        "maximumGapHours": { "type": "integer", "minimum": 24, "maximum": 168 },
        "runCount": { "type": "integer", "minimum": 1, "maximum": 50 },
        "firstRunAt": { "type": "string", "format": "date-time" },
        "lastRunAt": { "type": "string", "format": "date-time" }
      }
    },
    "trendRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "runAttempt",
        "runUrl",
        "source",
        "gitSha",
        "createdAt",
        "completedAt",
        "evidenceSha256",
        "scenarioRunSha256",
        "metrics"
      ],
      "properties": {
        "runId": { "type": "integer", "minimum": 1 },
        "runAttempt": { "type": "integer", "minimum": 1 },
        "runUrl": { "type": "string", "format": "uri" },
        "source": { "enum": ["retained", "current"] },
        "gitSha": { "$ref": "#/$defs/gitSha" },
        "createdAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "evidenceSha256": { "$ref": "#/$defs/sha256" },
        "scenarioRunSha256": { "$ref": "#/$defs/sha256" },
        "metrics": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9]*$" },
          "additionalProperties": { "$ref": "#/$defs/trendMetric" }
        }
      }
    },
    "trendMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["median", "p95", "regressionPercent", "regressionUnbounded", "status"],
      "properties": {
        "median": { "type": "number" },
        "p95": { "type": "number" },
        "regressionPercent": { "type": ["number", "null"] },
        "regressionUnbounded": { "type": "boolean" },
        "status": { "enum": ["candidate", "passing", "regressed"] }
      }
    },
    "metricContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "direction", "min", "max"],
      "properties": {
        "unit": { "type": "string" },
        "direction": { "enum": ["minimum", "maximum"] },
        "min": { "type": ["number", "null"] },
        "max": { "type": ["number", "null"] }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "status", "phase", "failedAt", "error", "failureSha256"],
      "properties": {
        "schemaVersion": { "const": "tixkit-performance-trend-failure-v1" },
        "status": { "const": "failed" },
        "phase": { "type": "string", "minLength": 1, "maxLength": 64 },
        "failedAt": { "type": "string", "format": "date-time" },
        "error": { "type": "string", "minLength": 1, "maxLength": 500 },
        "failureSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
