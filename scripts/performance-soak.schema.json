{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tixkit.com/performance/soak-v1.json",
  "title": "Tixkit trusted-host continuous integration soak",
  "oneOf": [{ "$ref": "#/$defs/config" }, { "$ref": "#/$defs/evidence" }],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "image"],
      "properties": {
        "engine": { "enum": ["postgresql", "mysql"] },
        "image": { "type": "string", "pattern": "^[^@]+@sha256:[a-f0-9]{64}$" }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkoutCapacity",
        "checkoutConcurrency",
        "scannerConcurrency",
        "streamedExportRows"
      ],
      "properties": {
        "checkoutCapacity": { "const": 25 },
        "checkoutConcurrency": { "const": 120 },
        "scannerConcurrency": { "const": 60 },
        "streamedExportRows": { "const": 2500 }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "args", "env"],
      "properties": {
        "executable": { "const": "bash" },
        "args": { "type": "array", "minItems": 2, "items": { "type": "string" } },
        "env": {
          "type": "object",
          "additionalProperties": false,
          "required": ["PERFORMANCE_METRICS_PATH"],
          "properties": {
            "PERFORMANCE_METRICS_PATH": { "const": "{metricsPath}" },
            "DB_INTEGRATION_DRIVER": { "const": "mysql" }
          }
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "runnerLabel",
        "database",
        "durationSeconds",
        "minimumIterations",
        "maximumIterations",
        "maximumLaunchGapSeconds",
        "windowSize",
        "maximumAdverseMedianDriftPercent",
        "iterationTimeoutSeconds",
        "workload",
        "budgets",
        "metrics",
        "command"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9](?:[-a-z0-9]{0,62})$" },
        "runnerLabel": { "const": "tixkit-epyc-trusted" },
        "database": { "$ref": "#/$defs/database" },
        "durationSeconds": { "const": 14400 },
        "minimumIterations": { "type": "integer", "minimum": 24, "maximum": 4096 },
        "maximumIterations": { "const": 4096 },
        "maximumLaunchGapSeconds": { "type": "number", "minimum": 0, "maximum": 5 },
        "windowSize": { "const": 6 },
        "maximumAdverseMedianDriftPercent": { "type": "number", "minimum": 0, "maximum": 15 },
        "iterationTimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 900 },
        "workload": { "$ref": "#/$defs/workload" },
        "budgets": { "const": "performance-budgets.integration.json" },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "command": { "$ref": "#/$defs/command" }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$schema", "schemaVersion", "claimScope", "profiles"],
      "properties": {
        "$schema": { "const": "./scripts/performance-soak.schema.json" },
        "schemaVersion": { "const": "tixkit-performance-soak-config-v1" },
        "claimScope": { "const": "trusted-single-host-continuous-integration-soak" },
        "profiles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/profile" } }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gitSha",
        "runnerLabel",
        "profile",
        "database",
        "workloadSha256",
        "configSha256",
        "budgetSha256"
      ],
      "properties": {
        "gitSha": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
        "runnerLabel": { "const": "tixkit-epyc-trusted" },
        "profile": { "type": "string", "minLength": 1 },
        "database": { "$ref": "#/$defs/database" },
        "workloadSha256": { "$ref": "#/$defs/sha256" },
        "configSha256": { "$ref": "#/$defs/sha256" },
        "budgetSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "iteration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "startedAt",
        "completedAt",
        "launchedAtOffsetMs",
        "completedAtOffsetMs",
        "durationMs",
        "launchGapMs",
        "rawSha256",
        "metrics",
        "sealedSampleSha256"
      ],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "launchedAtOffsetMs": { "type": "number", "minimum": 0 },
        "completedAtOffsetMs": { "type": "number", "exclusiveMinimum": 0 },
        "durationMs": { "type": "number", "exclusiveMinimum": 0 },
        "launchGapMs": { "type": ["number", "null"], "minimum": 0 },
        "rawSha256": { "$ref": "#/$defs/sha256" },
        "metrics": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "number", "minimum": 0 }
        },
        "sealedSampleSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "drift": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "firstWindowMedian",
        "lastWindowMedian",
        "adverseMedianDriftPercent",
        "withinThreshold"
      ],
      "properties": {
        "metric": { "type": "string", "minLength": 1 },
        "firstWindowMedian": { "type": "number", "minimum": 0 },
        "lastWindowMedian": { "type": "number", "minimum": 0 },
        "adverseMedianDriftPercent": { "type": "number", "minimum": 0 },
        "withinThreshold": { "const": true }
      }
    },
    "metricSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "min", "median", "p95", "max"],
      "properties": {
        "metric": { "type": "string", "minLength": 1 },
        "min": { "type": "number", "minimum": 0 },
        "median": { "type": "number", "minimum": 0 },
        "p95": { "type": "number", "minimum": 0 },
        "max": { "type": "number", "minimum": 0 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "status",
        "claimScope",
        "denials",
        "integrityModel",
        "identity",
        "controls",
        "iterations",
        "metricSummary",
        "drift",
        "evidenceSha256"
      ],
      "properties": {
        "schemaVersion": { "const": "tixkit-performance-soak-evidence-v1" },
        "status": { "const": "passed" },
        "claimScope": { "const": "trusted-single-host-continuous-integration-soak" },
        "denials": {
          "const": [
            "Production soak stability",
            "Cloud soak stability",
            "Compact soak stability",
            "same-process memory-leak proof",
            "provider resilience",
            "Temporal resilience",
            "capacity",
            "RUM",
            "SLA/SLO attainment",
            "immutable or publicly published evidence"
          ]
        },
        "integrityModel": { "const": "checksums-not-signatures" },
        "identity": { "$ref": "#/$defs/identity" },
        "controls": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requiredDurationSeconds",
            "actualDurationMs",
            "minimumIterations",
            "actualIterations",
            "maximumIterations",
            "maximumLaunchGapSeconds",
            "maximumObservedLaunchGapMs",
            "windowSize",
            "maximumAdverseMedianDriftPercent",
            "freshProcessPerIteration"
          ],
          "properties": {
            "requiredDurationSeconds": { "const": 14400 },
            "actualDurationMs": { "type": "number", "minimum": 14400000 },
            "minimumIterations": { "type": "integer", "minimum": 24 },
            "actualIterations": { "type": "integer", "minimum": 24 },
            "maximumIterations": { "const": 4096 },
            "maximumLaunchGapSeconds": { "type": "number", "minimum": 0, "maximum": 5 },
            "maximumObservedLaunchGapMs": { "type": "number", "minimum": 0, "maximum": 5000 },
            "windowSize": { "const": 6 },
            "maximumAdverseMedianDriftPercent": { "type": "number", "minimum": 0, "maximum": 15 },
            "freshProcessPerIteration": { "const": true }
          }
        },
        "iterations": {
          "type": "array",
          "minItems": 24,
          "maxItems": 4096,
          "items": { "$ref": "#/$defs/iteration" }
        },
        "metricSummary": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/metricSummary" }
        },
        "drift": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/drift" } },
        "evidenceSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
