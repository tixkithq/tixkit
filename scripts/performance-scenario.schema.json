{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tixkit.com/performance/scenarios-v1.json",
  "title": "Tixkit scheduled performance scenarios",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scenarios"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "tixkit-performance-scenarios-v1" },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scenario" }
    }
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "profile",
        "durationSeconds",
        "sampleIntervalSeconds",
        "sampleCount",
        "timeoutSeconds",
        "maxRegressionPercent",
        "runnerLabel",
        "database",
        "workload",
        "budgets",
        "command"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9](?:[-a-z0-9]{0,62})$" },
        "profile": { "type": "string", "minLength": 1 },
        "durationSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "sampleIntervalSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 21600
        },
        "sampleCount": { "type": "integer", "minimum": 3, "maximum": 144 },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 21600 },
        "maxRegressionPercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "runnerLabel": { "type": "string", "minLength": 1 },
        "database": {
          "type": "object",
          "additionalProperties": false,
          "required": ["engine", "version"],
          "properties": {
            "engine": { "enum": ["postgresql", "mysql"] },
            "version": { "type": "string", "minLength": 1 }
          }
        },
        "workload": { "type": "object", "minProperties": 1 },
        "budgets": { "type": "string", "minLength": 1 },
        "command": {
          "type": "object",
          "additionalProperties": false,
          "required": ["executable", "args"],
          "properties": {
            "executable": { "type": "string", "minLength": 1 },
            "args": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" }
            },
            "env": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          }
        }
      }
    },
    "runArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "status",
        "scenarioId",
        "profile",
        "scenarioSha256",
        "startedAt",
        "completedAt",
        "durationMilliseconds",
        "scheduledDurationMilliseconds",
        "sampleIntervalMilliseconds",
        "sampleCount",
        "sampleStartedAt",
        "aggregateSha256",
        "resultSha256"
      ],
      "properties": {
        "schemaVersion": { "const": "tixkit-performance-scenario-run-v1" },
        "status": { "const": "passed" },
        "scenarioId": { "type": "string", "minLength": 1 },
        "profile": { "type": "string", "minLength": 1 },
        "scenarioSha256": { "$ref": "#/$defs/sha256" },
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "durationMilliseconds": { "type": "integer", "minimum": 1 },
        "scheduledDurationMilliseconds": { "type": "integer", "minimum": 1 },
        "sampleIntervalMilliseconds": { "type": "integer", "minimum": 1 },
        "sampleCount": { "type": "integer", "minimum": 3 },
        "sampleStartedAt": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "format": "date-time" }
        },
        "aggregateSha256": { "$ref": "#/$defs/sha256" },
        "baselineEvidenceSha256": { "$ref": "#/$defs/sha256" },
        "resultSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "failureArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "status",
        "scope",
        "scenarioId",
        "phase",
        "failedAt",
        "error",
        "failureSha256"
      ],
      "properties": {
        "schemaVersion": { "const": "tixkit-performance-scenario-failure-v1" },
        "status": { "const": "failed" },
        "scope": { "enum": ["runner", "workflow"] },
        "scenarioId": { "type": "string", "minLength": 1, "maxLength": 63 },
        "phase": { "type": "string", "minLength": 1, "maxLength": 64 },
        "failedAt": { "type": "string", "format": "date-time" },
        "error": { "type": "string", "minLength": 1, "maxLength": 500 },
        "failureSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
