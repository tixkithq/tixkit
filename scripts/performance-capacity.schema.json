{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tixkit.com/performance/capacity-v2.json",
  "title": "Tixkit trusted single-host capacity characterization",
  "oneOf": [{ "$ref": "#/$defs/config" }, { "$ref": "#/$defs/evidence" }],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "runnerFingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sha256"],
      "properties": {
        "version": { "const": "tixkit-runner-fingerprint-v2" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "image"],
      "properties": {
        "engine": { "enum": ["postgresql", "mysql"] },
        "image": { "type": "string", "pattern": "^[^@]+@sha256:[a-f0-9]{64}$" }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "args", "env"],
      "properties": {
        "executable": { "type": "string", "minLength": 1 },
        "args": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "env": {
          "type": "object",
          "required": [
            "CAPACITY_METRICS_PATH",
            "CAPACITY_CHECKOUT_INVENTORY",
            "CAPACITY_CHECKOUT_CONCURRENCY"
          ],
          "additionalProperties": false,
          "properties": {
            "CAPACITY_METRICS_PATH": { "type": "string" },
            "CAPACITY_CHECKOUT_INVENTORY": { "type": "string" },
            "CAPACITY_CHECKOUT_CONCURRENCY": { "type": "string" }
          }
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "runnerLabel",
        "database",
        "inventory",
        "concurrencyPoints",
        "samplesPerPoint",
        "timeoutSeconds",
        "saturationP95Ms",
        "minThroughputGainPercent",
        "command"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9](?:[-a-z0-9]{0,62})$" },
        "runnerLabel": { "type": "string", "minLength": 1 },
        "database": { "$ref": "#/$defs/database" },
        "inventory": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "concurrencyPoints": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 1000000 }
        },
        "samplesPerPoint": { "type": "integer", "minimum": 3, "maximum": 20 },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "saturationP95Ms": { "type": "number", "exclusiveMinimum": 0 },
        "minThroughputGainPercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "command": { "$ref": "#/$defs/command" }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$schema", "schemaVersion", "claimScope", "profiles"],
      "properties": {
        "$schema": { "type": "string" },
        "schemaVersion": { "const": "tixkit-performance-capacity-config-v1" },
        "claimScope": {
          "const": "trusted-single-host-capacity-characterization"
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/profile" }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempts",
        "successes",
        "expectedInventoryDeclines",
        "platformFailures",
        "elapsedMs",
        "requestThroughputPerSecond",
        "successfulReservationThroughputPerSecond",
        "successfulReservationP50Ms",
        "successfulReservationP95Ms"
      ],
      "properties": {
        "attempts": { "type": "integer", "minimum": 1 },
        "successes": { "type": "integer", "minimum": 0 },
        "expectedInventoryDeclines": { "type": "integer", "minimum": 0 },
        "platformFailures": { "type": "integer", "minimum": 0 },
        "elapsedMs": { "type": "number", "exclusiveMinimum": 0 },
        "requestThroughputPerSecond": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "successfulReservationThroughputPerSecond": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "successfulReservationP50Ms": { "type": "number", "minimum": 0 },
        "successfulReservationP95Ms": { "type": "number", "minimum": 0 }
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample", "rawSha256", "metrics"],
      "properties": {
        "sample": { "type": "integer", "minimum": 1 },
        "rawSha256": { "$ref": "#/$defs/sha256" },
        "metrics": { "$ref": "#/$defs/metrics" }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "concurrency",
        "publishable",
        "throughputGainPercent",
        "medianSuccessfulReservationThroughputPerSecond",
        "medianSuccessfulReservationP95Ms",
        "samples"
      ],
      "properties": {
        "concurrency": { "type": "integer", "minimum": 1 },
        "publishable": { "type": "boolean" },
        "throughputGainPercent": {
          "oneOf": [{ "type": "number" }, { "type": "null" }]
        },
        "medianSuccessfulReservationThroughputPerSecond": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "medianSuccessfulReservationP95Ms": { "type": "number", "minimum": 0 },
        "samples": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/sample" }
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gitSha",
        "runnerLabel",
        "runnerFingerprint",
        "profile",
        "database",
        "workloadSha256",
        "configSha256"
      ],
      "properties": {
        "gitSha": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "runnerLabel": { "type": "string", "minLength": 1 },
        "runnerFingerprint": { "$ref": "#/$defs/runnerFingerprint" },
        "profile": { "type": "string", "minLength": 1 },
        "database": { "$ref": "#/$defs/database" },
        "workloadSha256": { "$ref": "#/$defs/sha256" },
        "configSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "claimScope",
        "denials",
        "integrityModel",
        "identity",
        "points",
        "saturation",
        "capacityClaim",
        "evidenceSha256"
      ],
      "properties": {
        "schemaVersion": { "const": "tixkit-performance-capacity-evidence-v2" },
        "claimScope": {
          "const": "trusted-single-host-capacity-characterization"
        },
        "denials": {
          "const": ["Production capacity", "Cloud capacity", "Compact capacity", "general capacity"]
        },
        "integrityModel": { "const": "checksums-not-signatures" },
        "identity": { "$ref": "#/$defs/identity" },
        "points": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/point" }
        },
        "saturation": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["concurrency", "reason"],
              "properties": {
                "concurrency": { "type": "integer", "minimum": 1 },
                "reason": {
                  "enum": ["p95-threshold", "throughput-gain-threshold", "platform-failure"]
                }
              }
            }
          ]
        },
        "capacityClaim": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["maxPublishableConcurrency", "saturationObservedAtConcurrency"],
              "properties": {
                "maxPublishableConcurrency": {
                  "type": "integer",
                  "minimum": 1
                },
                "saturationObservedAtConcurrency": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          ]
        },
        "evidenceSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
