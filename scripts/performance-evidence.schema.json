{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tixkit.com/performance/evidence-v1.json",
  "title": "Tixkit trusted multi-sample performance evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "identity",
    "sampleCount",
    "metricSet",
    "samples",
    "metrics",
    "evidenceSha256"
  ],
  "properties": {
    "schemaVersion": { "const": "tixkit-performance-evidence-v1" },
    "identity": { "$ref": "#/$defs/identity" },
    "sampleCount": { "type": "integer", "minimum": 3 },
    "metricSet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "samples": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "payloadSha256", "sourceMetricsSha256"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "payloadSha256": { "$ref": "#/$defs/sha256" },
          "sourceMetricsSha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "metrics": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/metricEvidence" }
    },
    "evidenceSha256": { "$ref": "#/$defs/sha256" },
    "regression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baselineSha256", "maxRegressionPercent", "comparisons"],
      "properties": {
        "baselineSha256": { "$ref": "#/$defs/sha256" },
        "maxRegressionPercent": { "type": "number", "minimum": 0 },
        "comparisons": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/comparison" }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sampleArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "identity", "sourceMetricsSha256", "metrics", "payloadSha256"],
      "properties": {
        "schemaVersion": { "const": "tixkit-performance-sample-v1" },
        "identity": { "$ref": "#/$defs/identity" },
        "sourceMetricsSha256": { "$ref": "#/$defs/sha256" },
        "metrics": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "number" }
        },
        "payloadSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gitSha", "runnerLabel", "database", "workload"],
      "properties": {
        "gitSha": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "runnerLabel": { "type": "string", "minLength": 1 },
        "profile": { "type": "string", "minLength": 1 },
        "database": {
          "type": "object",
          "additionalProperties": false,
          "required": ["engine", "version"],
          "properties": {
            "engine": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 }
          }
        },
        "workload": { "type": "object" }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": { "min": { "type": "number" }, "max": { "type": "number" } }
    },
    "metricEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "budget", "samples", "min", "median", "p95", "max"],
      "properties": {
        "unit": { "type": "string" },
        "budget": { "$ref": "#/$defs/budget" },
        "samples": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "number" }
        },
        "min": { "type": "number" },
        "median": { "type": "number" },
        "p95": { "type": "number" },
        "max": { "type": "number" }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baselineMedian", "currentMedian", "percent"],
      "properties": {
        "baselineMedian": { "type": "number" },
        "currentMedian": { "type": "number" },
        "percent": { "type": "number" }
      }
    }
  }
}
