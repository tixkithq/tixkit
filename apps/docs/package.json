{
  "name": "@tixkit/docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun ../../scripts/docs/generate-openapi-reference.mjs && node ../../scripts/docs/generate-content-manifest.mjs && next dev -p 3002",
    "build": "bun ../../scripts/docs/generate-openapi-reference.mjs && node ../../scripts/docs/generate-content-manifest.mjs && tsc --noEmit && next build",
    "build:static": "bun ../../scripts/docs/generate-openapi-reference.mjs && node ../../scripts/docs/generate-content-manifest.mjs && tsc --noEmit && TIXKIT_DOCS_STATIC_EXPORT=1 next build",
    "start": "next start -p 3002",
    "lint": "oxlint src next.config.mjs",
    "typecheck": "node ../../scripts/docs/generate-content-manifest.mjs && tsc --noEmit",
    "test:unit": "vitest run",
    "clean": "rm -rf .next out"
  },
  "dependencies": {
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "16.2.10",
    "@tixkit/docs-core": "workspace:*",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-mdx-frontmatter": "5.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.2",
    "@types/node": "^26.1.1",
    "@types/mdx": "2.0.14",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "oxlint": "^1.73.0",
    "tailwindcss": "4.3.2",
    "typescript": "7.0.2",
    "vitest": "^4.1.10"
  }
}
