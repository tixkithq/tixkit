---
import { checkoutUrl, tixkitWidgetIframeAttributes } from '@tixkit/astro';

export const prerender = true;

const checkoutBaseUrl = import.meta.env.PUBLIC_TIXKIT_CHECKOUT_URL ?? 'http://localhost:3201';

const widgetAttrs = tixkitWidgetIframeAttributes({
  widgetBaseUrl: checkoutBaseUrl,
  brand: 'brd_demo',
  event: 'evt_demo',
  mode: 'inline',
  title: 'Tixkit Ticket Widget',
});

const handoffUrl = checkoutUrl({
  event: 'evt_demo',
  brand: 'brd_demo',
  items: [{ ticketTypeId: 'tt_demo_general', quantity: 2 }],
  checkoutBaseUrl,
});
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Tixkit Astro Demo</title>
</head>
<body>
  <main style="font-family: system-ui, sans-serif; max-width: 960px; margin: 0 auto; padding: 32px;">
    <h1>Tixkit Astro Demo</h1>
    <p>Demonstrates the @tixkit/astro SDK: widget iframe, checkout handoff, and lifecycle events.</p>

    <section style="margin-top: 24px;">
      <h2>Inline Widget</h2>
      <iframe
        id="tixkit-widget-demo"
        src={widgetAttrs.src}
        title={widgetAttrs.title}
        sandbox={widgetAttrs.sandbox}
        allow={widgetAttrs.allow}
        referrerpolicy={widgetAttrs.referrerPolicy}
        style="width: 100%; height: 560px; border: 0;"
      ></iframe>
    </section>

    <section style="margin-top: 24px;">
      <h2>Checkout Handoff URL</h2>
      <code data-testid="checkout-handoff-url">{handoffUrl}</code>
    </section>

    <section style="margin-top: 24px;">
      <h2>Lifecycle Events</h2>
      <output id="events" aria-label="Tixkit lifecycle events">No events yet</output>
    </section>
  </main>

  <script is:inline define:vars={{ checkoutOrigin: new URL(checkoutBaseUrl).origin }}>
    const events = [];
    const output = document.getElementById('events');
    window.addEventListener('message', (message) => {
      if (message.origin && message.origin !== checkoutOrigin) return;
      const raw = message.data || {};
      const type = raw.type ?? raw.event;
      if (!type) return;
      events.push(type);
      if (output) output.textContent = events.join(', ');
    });
  </script>
</body>
</html>
