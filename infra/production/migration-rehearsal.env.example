# Non-secret shared inputs. Use canonical absolute paths and immutable release refs.
DR_REHEARSAL_ID=replace-with-unique-rehearsal-id
DR_MANIFEST_KEY_ID=replace-with-signing-key-id
DR_SOURCE_RELEASE=ghcr.io/tixkithq/tixkit-migrations@sha256:replace-with-64-lowercase-hex-characters
DR_OLD_RELEASE=ghcr.io/tixkithq/tixkit-migrations@sha256:replace-with-64-lowercase-hex-characters
DR_NEW_RELEASE=ghcr.io/tixkithq/tixkit-migrations@sha256:replace-with-64-lowercase-hex-characters
DR_OLD_RELEASE_MANIFEST=/absolute/path/to/signed-old-release-attestation.json
DR_NEW_RELEASE_MANIFEST=/absolute/path/to/signed-new-release-attestation.json
DR_OLD_VERSION_VERIFY_COMMAND=/absolute/path/to/old-release-verifier
DR_NEW_VERSION_VERIFY_COMMAND=/absolute/path/to/new-release-verifier
DR_DATABASE_IDENTITY_COMMAND=/absolute/path/to/database-identity-and-reconciliation
DR_MIGRATION_COMMAND=/absolute/path/to/new-release-migration-runner
DR_MIGRATION_ARTIFACT=/absolute/path/to/immutable-migration-artifact
BACKUP_DIR=/absolute/canonical/path/to/private-backup-directory
DR_EVIDENCE_DIR=/absolute/canonical/path/to/private-evidence-directory
DR_BACKUP_ENCRYPTION=replace-with-provider-key-identifier
DR_BACKUP_DESTINATION_CLASS=independent
# Export one honest UTC anchor as both DR_RECOVERY_POINT_AT and DR_INCIDENT_AT
# immediately before each command. Do not record an incident earlier than the
# backup's declared recovery point.

# Three physically independent PostgreSQL roles.
POSTGRES_SOURCE_DATABASE_URL=postgres://replace-with-source
POSTGRES_FORWARD_DATABASE_URL=postgres://replace-with-empty-forward-clone
POSTGRES_ROLLBACK_DATABASE_URL=postgres://replace-with-empty-rollback-clone
POSTGRES_FORWARD_TARGET_ID=replace-with-forward-target-id
POSTGRES_ROLLBACK_TARGET_ID=replace-with-rollback-target-id

# Three physically independent MySQL roles.
MYSQL_SOURCE_DATABASE_URL=mysql://replace-with-source
MYSQL_FORWARD_DATABASE_URL=mysql://replace-with-empty-forward-clone
MYSQL_ROLLBACK_DATABASE_URL=mysql://replace-with-empty-rollback-clone
MYSQL_FORWARD_TARGET_ID=replace-with-forward-target-id
MYSQL_ROLLBACK_TARGET_ID=replace-with-rollback-target-id

# Optional bounded phase deadlines and combined output cap.
DR_BACKUP_TIMEOUT_MS=1800000
DR_RESTORE_TIMEOUT_MS=1800000
DR_MIGRATION_TIMEOUT_MS=600000
DR_VERIFY_TIMEOUT_MS=300000
DR_IDENTITY_TIMEOUT_MS=60000
DR_PHASE_MAX_OUTPUT_BYTES=4194304
