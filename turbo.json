{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.base.json"],
  "globalEnv": ["NODE_ENV", "DATABASE_URL_MSSQL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "AUTH_PROVIDER",
        "NEXT_PUBLIC_AUTH_PROVIDER",
        "TIXKIT_PREVIEW_TOKEN_SECRET",
        "PUBLIC_CHECKOUT_URL",
        "CHECKOUT_PUBLIC_URL",
        "NEXT_PUBLIC_ADMIN_ORIGIN",
        "NEXT_PUBLIC_CHECKOUT_URL",
        "NEXT_PUBLIC_TIXKIT_CHECKOUT_URL",
        "API_BASE_URL",
        "NEXT_PUBLIC_TIXKIT_API_BASE_URL",
        "NEXT_PUBLIC_ADMIN_API_BASE_URL",
        "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY",
        "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY"
      ],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": [
        "AUTH_PROVIDER",
        "DATABASE_URL",
        "DATABASE_URL_MYSQL",
        "DATABASE_URL_MSSQL",
        "DB_DRIVER",
        "DB_INTEGRATION_DRIVER",
        "REDIS_URL",
        "TEMPORAL_ADDRESS",
        "TEMPORAL_NAMESPACE",
        "TEMPORAL_TASK_QUEUE",
        "STRIPE_SECRET_KEY",
        "STRIPE_WEBHOOK_SECRET",
        "S3_ENDPOINT",
        "S3_BUCKET",
        "S3_ACCESS_KEY_ID",
        "S3_SECRET_ACCESS_KEY",
        "S3_REGION",
        "TELNYX_API_KEY",
        "TELNYX_WEBHOOK_PUBLIC_KEY"
      ],
      "outputs": []
    },
    "test:unit": {
      "dependsOn": ["^build"],
      "env": [
        "AUTH_PROVIDER",
        "DATABASE_URL",
        "DATABASE_URL_MYSQL",
        "DATABASE_URL_MSSQL",
        "DB_DRIVER",
        "REDIS_URL",
        "TEMPORAL_ADDRESS",
        "TEMPORAL_NAMESPACE",
        "TEMPORAL_TASK_QUEUE",
        "STRIPE_SECRET_KEY",
        "STRIPE_WEBHOOK_SECRET",
        "S3_ENDPOINT",
        "S3_BUCKET",
        "S3_ACCESS_KEY_ID",
        "S3_SECRET_ACCESS_KEY",
        "S3_REGION",
        "TELNYX_API_KEY",
        "TELNYX_WEBHOOK_PUBLIC_KEY"
      ],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "env": [
        "AUTH_PROVIDER",
        "DATABASE_URL",
        "DATABASE_URL_MYSQL",
        "DATABASE_URL_MSSQL",
        "DB_DRIVER",
        "DB_INTEGRATION_DRIVER",
        "REDIS_URL",
        "TEMPORAL_ADDRESS",
        "TEMPORAL_NAMESPACE",
        "TEMPORAL_TASK_QUEUE",
        "STRIPE_SECRET_KEY",
        "STRIPE_WEBHOOK_SECRET",
        "S3_ENDPOINT",
        "S3_BUCKET",
        "S3_ACCESS_KEY_ID",
        "S3_SECRET_ACCESS_KEY",
        "S3_REGION",
        "TELNYX_API_KEY",
        "TELNYX_WEBHOOK_PUBLIC_KEY"
      ],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
