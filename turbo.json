{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.base.json", ".env", ".env.local"],
  "globalEnv": [
    "NODE_ENV",
    "AUTH_PROVIDER",
    "NEXT_PUBLIC_AUTH_PROVIDER",
    "DATABASE_URL",
    "DATABASE_URL_MYSQL",
    "DATABASE_URL_MSSQL",
    "DB_DRIVER",
    "DB_INTEGRATION_DRIVER",
    "REDIS_URL",
    "TEMPORAL_ADDRESS",
    "CLERK_SECRET_KEY",
    "CLERK_PUBLISHABLE_KEY",
    "CLERK_WEBHOOK_SECRET",
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "S3_ENDPOINT",
    "S3_BUCKET",
    "S3_ACCESS_KEY_ID",
    "S3_SECRET_ACCESS_KEY",
    "OTEL_EXPORTER_OTLP_ENDPOINT",
    "OTEL_EXPORTER_OTLP_TRACES_ENDPOINT",
    "OTEL_SDK_DISABLED",
    "PROMETHEUS_PUSHGATEWAY_URL",
    "LOG_LEVEL",
    "PORT",
    "TIXKIT_PREVIEW_TOKEN_SECRET",
    "PUBLIC_CHECKOUT_URL",
    "CHECKOUT_PUBLIC_URL",
    "NEXT_PUBLIC_ADMIN_ORIGIN",
    "NEXT_PUBLIC_CHECKOUT_URL",
    "NEXT_PUBLIC_TIXKIT_CHECKOUT_URL",
    "API_BASE_URL",
    "NEXT_PUBLIC_TIXKIT_API_BASE_URL",
    "NEXT_PUBLIC_ADMIN_API_BASE_URL",
    "S3_REGION",
    "STRIPE_CONNECT_CLIENT_ID",
    "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY",
    "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
    "TELNYX_API_KEY",
    "TELNYX_WEBHOOK_PUBLIC_KEY",
    "TWILIO_ACCOUNT_SID",
    "TWILIO_AUTH_TOKEN",
    "VONAGE_API_KEY",
    "VONAGE_API_SECRET",
    "PLIVO_AUTH_ID",
    "PLIVO_AUTH_TOKEN"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:unit": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
