{
  "$schema": "./scripts/performance-scenario.schema.json",
  "schemaVersion": "tixkit-performance-scenarios-v1",
  "scenarios": [
    {
      "id": "postgresql-trusted-soak",
      "profile": "trusted-single-host-regression",
      "durationSeconds": 1800,
      "sampleIntervalSeconds": 600,
      "sampleCount": 4,
      "timeoutSeconds": 540,
      "maxRegressionPercent": 10,
      "runnerLabel": "tixkit-epyc-trusted",
      "database": {
        "engine": "postgresql",
        "version": "16-alpine@sha256:e013e867e712fec275706a6c51c966f0bb0c93cfa8f51000f85a15f9865a28cb"
      },
      "workload": {
        "checkoutCapacity": 25,
        "checkoutConcurrency": 120,
        "scannerConcurrency": 60,
        "streamedExportRows": 2500,
        "processSamples": 4
      },
      "budgets": "performance-budgets.integration.json",
      "command": {
        "executable": "bash",
        "args": [
          "-c",
          "cd packages/api && bun vitest run src/__tests__/integration/inventory-concurrency.integration.test.ts src/__tests__/integration/load-harness.integration.test.ts --no-file-parallelism --maxWorkers=1 && cd ../.. && bun run --cwd packages/workflows test:unit -- export-activity.test.ts"
        ],
        "env": { "PERFORMANCE_METRICS_PATH": "{metricsPath}" }
      }
    },
    {
      "id": "mysql-trusted-soak",
      "profile": "trusted-single-host-regression",
      "durationSeconds": 1800,
      "sampleIntervalSeconds": 600,
      "sampleCount": 4,
      "timeoutSeconds": 540,
      "maxRegressionPercent": 10,
      "runnerLabel": "tixkit-epyc-trusted",
      "database": {
        "engine": "mysql",
        "version": "8.4@sha256:d36d39a64cd12a5c1cc9e6aa2bfb5f8d4c81a2f6586e0a04a9ae13939db02209"
      },
      "workload": {
        "checkoutCapacity": 25,
        "checkoutConcurrency": 120,
        "scannerConcurrency": 60,
        "streamedExportRows": 2500,
        "processSamples": 4
      },
      "budgets": "performance-budgets.integration.json",
      "command": {
        "executable": "bash",
        "args": [
          "-c",
          "cd packages/api && bun vitest run src/__tests__/integration/inventory-concurrency.integration.test.ts src/__tests__/integration/load-harness.integration.test.ts --no-file-parallelism --maxWorkers=1 && cd ../.. && bun run --cwd packages/workflows test:unit -- export-activity.test.ts"
        ],
        "env": {
          "DB_INTEGRATION_DRIVER": "mysql",
          "PERFORMANCE_METRICS_PATH": "{metricsPath}"
        }
      }
    }
  ]
}
