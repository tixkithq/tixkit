{
  "name": "@tixkit/content-email",
  "version": "1.0.0",
  "description": "Tixkit email content contracts, defaults, and rendering adapters",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tixkithq/tixkit.git",
    "directory": "packages/content-email"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/__tests__",
    "!dist/**/*.test.*",
    "!dist/.tsbuildinfo",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b",
    "lint": "oxlint src",
    "typecheck": "tsc -b",
    "test:unit": "vitest run",
    "prepack": "bun run build",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@react-email/components": "^1.0.12",
    "@react-email/editor": "^1.5.10",
    "@react-email/render": "^2.0.9",
    "@tixkit/content-core": "1.0.0",
    "@tixkit/domain": "1.0.0",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "typescript": "7.0.2",
    "vitest": "^4.1.0"
  }
}
