{
  "name": "@tixkit/contract-tests",
  "version": "0.1.0",
  "description": "Executable Tixkit embed, webhook, SDK/API, and agent-platform contract profiles",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tixkit/tixkit.git",
    "directory": "packages/contract-tests"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "tixkit-contract-tests": "./dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "lint": "oxlint src",
    "test:unit": "vitest run",
    "prepack": "bun run build && chmod +x dist/cli.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@tixkit/agent-protocol": "0.1.0",
    "@tixkit/embed-core": "1.0.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "^4.1.0"
  }
}
