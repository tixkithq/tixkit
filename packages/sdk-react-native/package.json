{
  "name": "@tixkit/react-native",
  "version": "0.1.0",
  "description": "Official React Native integration for Tixkit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tixkit/tixkit.git",
    "directory": "packages/sdk-react-native"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/__tests__",
    "!dist/**/*.test.*",
    "!dist/.tsbuildinfo",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.73"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc -b",
    "lint": "oxlint src",
    "typecheck": "tsc -b",
    "test:unit": "vitest run",
    "prepack": "bun run build",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@tixkit/js": "0.1.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "^4.1.0"
  }
}
