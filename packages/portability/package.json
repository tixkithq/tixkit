{
  "name": "@tixkit/portability",
  "version": "0.1.0",
  "description": "Shared signed logical portability bundle contracts for Tixkit Cloud and Self-Hosted",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tixkit/tixkit.git",
    "directory": "packages/portability"
  },
  "homepage": "https://github.com/tixkit/tixkit#readme",
  "bugs": "https://github.com/tixkit/tixkit/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "schemas",
    "!dist/.tsbuildinfo",
    "!dist/**/__tests__/**",
    "!dist/**/*.test.*",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": "./schemas/portable-bundle-2026-07-12.json",
    "./signature-schema": "./schemas/portable-bundle-signature-2026-07-12.json",
    "./canonical-json-vectors": "./schemas/canonical-json-v1-vectors.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "lint": "oxlint src",
    "test:unit": "vitest run",
    "prepack": "bun run build",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "^4.1.0"
  }
}
