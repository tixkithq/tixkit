{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tixkit.com/schemas/portable-bundle-2026-07-14.json",
  "title": "Tixkit Portable Bundle Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "format",
    "bundleId",
    "mode",
    "source",
    "apiVersion",
    "dataSchemaVersion",
    "exportedAt",
    "lineage",
    "compatibility",
    "entityCounts",
    "files",
    "payloadSafety",
    "assetSafety",
    "assets",
    "identity",
    "dependencies",
    "rebindings"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "format": { "const": "tixkit-portable-bundle-v2" },
    "bundleId": { "$ref": "#/$defs/id" },
    "mode": { "enum": ["configuration", "historical"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operatingModel", "deploymentId", "tenantId", "exportSequence", "changeCursor"],
      "properties": {
        "operatingModel": { "enum": ["cloud", "self-hosted"] },
        "deploymentId": { "$ref": "#/$defs/id" },
        "tenantId": { "$ref": "#/$defs/id" },
        "exportSequence": { "type": "integer", "minimum": 1 },
        "changeCursor": { "type": "string", "minLength": 1 },
        "frozenAt": { "type": "string", "format": "date-time" }
      }
    },
    "apiVersion": { "type": "string", "minLength": 1 },
    "dataSchemaVersion": { "type": "string", "minLength": 1 },
    "exportedAt": { "type": "string", "format": "date-time" },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "toChangeCursor"],
      "properties": {
        "kind": { "enum": ["full", "delta"] },
        "fromChangeCursor": { "type": "string", "minLength": 1 },
        "toChangeCursor": { "type": "string", "minLength": 1 },
        "parentBundleId": { "$ref": "#/$defs/id" },
        "parentManifestSha256": { "$ref": "#/$defs/sha256" },
        "cutoverFreeze": {
          "type": "object",
          "additionalProperties": false,
          "required": ["frozenAt", "receiptSha256"],
          "properties": {
            "frozenAt": { "type": "string", "format": "date-time" },
            "receiptSha256": { "$ref": "#/$defs/sha256" }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "delta" } }, "required": ["kind"] },
          "then": {
            "properties": {
              "fromChangeCursor": { "type": "string", "minLength": 1 },
              "parentBundleId": { "$ref": "#/$defs/id" },
              "parentManifestSha256": { "$ref": "#/$defs/sha256" }
            },
            "required": ["fromChangeCursor", "parentBundleId", "parentManifestSha256"]
          }
        }
      ]
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimumApiVersion",
        "maximumApiVersion",
        "minimumDataSchemaVersion",
        "maximumDataSchemaVersion",
        "requiredCapabilities",
        "requiredEntitlements"
      ],
      "properties": {
        "minimumApiVersion": { "type": "string" },
        "maximumApiVersion": { "type": "string" },
        "minimumDataSchemaVersion": { "type": "string" },
        "maximumDataSchemaVersion": { "type": "string" },
        "requiredCapabilities": { "type": "array", "items": { "type": "string" } },
        "requiredEntitlements": { "type": "array", "items": { "type": "string" } }
      }
    },
    "entityCounts": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/file" }
    },
    "payloadSafety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policyVersion", "scannedFiles", "findings"],
      "properties": {
        "policyVersion": { "const": "tixkit-portable-secret-policy-v1" },
        "scannedFiles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "section",
              "sha256",
              "records",
              "portableIdsSha256",
              "schemaId",
              "schemaSha256",
              "policySha256",
              "scannerId",
              "keyId",
              "signature"
            ],
            "properties": {
              "path": { "$ref": "#/$defs/path" },
              "section": { "$ref": "#/$defs/section" },
              "sha256": { "$ref": "#/$defs/sha256" },
              "records": { "type": "integer", "minimum": 0 },
              "portableIdsSha256": { "$ref": "#/$defs/sha256" },
              "schemaId": { "$ref": "#/$defs/id" },
              "schemaSha256": { "$ref": "#/$defs/sha256" },
              "policySha256": { "$ref": "#/$defs/sha256" },
              "scannerId": { "$ref": "#/$defs/id" },
              "keyId": { "$ref": "#/$defs/id" },
              "signature": { "type": "string", "minLength": 80, "maxLength": 120 }
            }
          }
        },
        "findings": { "const": 0 }
      }
    },
    "assetSafety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policyVersion", "scannedFiles", "findings"],
      "properties": {
        "policyVersion": { "const": "tixkit-portable-media-policy-v1" },
        "scannedFiles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "bytes",
              "policyVersion",
              "policySha256",
              "scannerId",
              "detectedMediaType",
              "width",
              "height",
              "malwareStatus",
              "metadataStripped",
              "decompressionSafe",
              "pixelLimitsSafe",
              "keyId",
              "signature"
            ],
            "properties": {
              "path": { "$ref": "#/$defs/path" },
              "sha256": { "$ref": "#/$defs/sha256" },
              "bytes": { "type": "integer", "minimum": 0 },
              "policyVersion": { "const": "tixkit-portable-media-policy-v1" },
              "policySha256": { "$ref": "#/$defs/sha256" },
              "scannerId": { "$ref": "#/$defs/id" },
              "detectedMediaType": { "type": "string", "minLength": 1 },
              "width": { "type": "integer", "minimum": 1 },
              "height": { "type": "integer", "minimum": 1 },
              "malwareStatus": { "const": "clean" },
              "metadataStripped": { "const": true },
              "decompressionSafe": { "const": true },
              "pixelLimitsSafe": { "const": true },
              "keyId": { "$ref": "#/$defs/id" },
              "signature": { "type": "string", "minLength": 80, "maxLength": 120 }
            }
          }
        },
        "findings": { "const": 0 }
      }
    },
    "assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/asset" }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "preserveSafeIds", "mappingRequired"],
      "properties": {
        "namespace": { "$ref": "#/$defs/id" },
        "preserveSafeIds": { "const": true },
        "mappingRequired": { "const": true }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["section", "dependsOn"],
        "properties": {
          "section": { "$ref": "#/$defs/section" },
          "dependsOn": { "type": "array", "items": { "$ref": "#/$defs/section" } }
        }
      }
    },
    "rebindings": {
      "type": "array",
      "items": { "$ref": "#/$defs/rebinding" }
    },
    "historicalAuthorization": { "$ref": "#/$defs/historicalAuthorization" }
  },
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "historical" } }, "required": ["mode"] },
      "then": {
        "properties": {
          "historicalAuthorization": { "$ref": "#/$defs/historicalAuthorization" }
        },
        "required": ["historicalAuthorization"]
      },
      "else": { "not": { "required": ["historicalAuthorization"] } }
    },
    {
      "if": { "properties": { "mode": { "const": "configuration" } }, "required": ["mode"] },
      "then": {
        "properties": {
          "files": {
            "not": {
              "type": "array",
              "contains": {
                "type": "object",
                "properties": {
                  "section": {
                    "enum": [
                      "orders",
                      "buyers",
                      "attendees",
                      "payments",
                      "refunds",
                      "tickets",
                      "scans",
                      "audit_logs",
                      "consent",
                      "delivery_history",
                      "financial_snapshots"
                    ]
                  }
                },
                "required": ["section"]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
    },
    "section": {
      "enum": [
        "organizations",
        "brands",
        "venues",
        "events",
        "occurrences",
        "inventory",
        "ticket_types",
        "products",
        "checkout_questions",
        "discounts",
        "access_codes",
        "policies",
        "content",
        "templates",
        "webhooks",
        "oauth_applications",
        "configuration",
        "buyers",
        "attendees",
        "orders",
        "payments",
        "refunds",
        "tickets",
        "scans",
        "audit_logs",
        "consent",
        "delivery_history",
        "financial_snapshots"
      ]
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "section", "sha256", "bytes", "records", "contentType"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "section": { "anyOf": [{ "$ref": "#/$defs/section" }, { "const": "assets" }] },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 0 },
        "records": { "type": "integer", "minimum": 0 },
        "contentType": {
          "enum": ["application/jsonl", "application/json", "application/octet-stream"]
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["portableId", "path", "sha256", "bytes", "mediaType", "role"],
      "properties": {
        "portableId": { "$ref": "#/$defs/id" },
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 0 },
        "mediaType": { "type": "string" },
        "role": { "type": "string" }
      }
    },
    "rebinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "portableId", "required"],
      "properties": {
        "kind": {
          "enum": [
            "custom_domain",
            "provider_account",
            "payment_provider_account",
            "email_delivery_route",
            "sms_delivery_route",
            "marketing_integration",
            "tax_registration",
            "sending_identity",
            "wallet_credential",
            "oauth_redirect_origin",
            "webhook_endpoint"
          ]
        },
        "portableId": { "$ref": "#/$defs/id" },
        "required": { "type": "boolean" }
      }
    },
    "historicalAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorizationId",
        "tenantId",
        "grantedByPrincipalId",
        "grantedAt",
        "expiresAt",
        "scope"
      ],
      "properties": {
        "authorizationId": { "$ref": "#/$defs/id" },
        "tenantId": { "$ref": "#/$defs/id" },
        "grantedByPrincipalId": { "$ref": "#/$defs/id" },
        "grantedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "scope": { "const": "tenant-historical-portability" }
      }
    }
  }
}
