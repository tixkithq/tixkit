{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tixkit.com/schemas/portable-bundle-signature-2026-07-12.json",
  "title": "Tixkit Portable Bundle Detached Signature",
  "type": "object",
  "additionalProperties": false,
  "required": ["algorithm", "keyId", "manifestSha256", "signature"],
  "properties": {
    "algorithm": { "const": "Ed25519" },
    "keyId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$" },
    "manifestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "signature": { "type": "string", "minLength": 80, "maxLength": 120 }
  }
}
