{
  "name": "@tixkit/agent-protocol",
  "version": "0.1.0",
  "description": "Shared agent principal, action, plan, approval, authorization, and audit safety contracts for Tixkit",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tixkit/tixkit.git",
    "directory": "packages/agent-protocol"
  },
  "homepage": "https://github.com/tixkit/tixkit#readme",
  "bugs": "https://github.com/tixkit/tixkit/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "schemas",
    "!dist/.tsbuildinfo",
    "!dist/**/__tests__/**",
    "!dist/**/*.test.*",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": "./schemas/agent-protocol-2026-08-03.json",
    "./schemas/2026-07-11": "./schemas/agent-protocol-2026-07-11.json",
    "./schemas/2026-07-22": "./schemas/agent-protocol-2026-07-22.json",
    "./schemas/2026-07-31": "./schemas/agent-protocol-2026-07-31.json",
    "./schemas/2026-08-01": "./schemas/agent-protocol-2026-08-01.json",
    "./schemas/2026-08-02": "./schemas/agent-protocol-2026-08-02.json",
    "./schemas/2026-08-03": "./schemas/agent-protocol-2026-08-03.json",
    "./schemas/agent-action-contracts/2026-07-27": "./schemas/agent-action-contracts-2026-07-27.json",
    "./schemas/agent-action-contracts/2026-07-29": "./schemas/agent-action-contracts-2026-07-29.json",
    "./schemas/agent-action-contracts/2026-07-30": "./schemas/agent-action-contracts-2026-07-30.json",
    "./schemas/agent-action-contracts/2026-07-31": "./schemas/agent-action-contracts-2026-07-31.json",
    "./schemas/agent-action-contracts/2026-08-01": "./schemas/agent-action-contracts-2026-08-01.json",
    "./schemas/agent-action-contracts/2026-08-02": "./schemas/agent-action-contracts-2026-08-02.json",
    "./schemas/agent-action-contracts/2026-08-03": "./schemas/agent-action-contracts-2026-08-03.json",
    "./schemas/agent-plan/2026-07-27": "./schemas/agent-plan-2026-07-27.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "lint": "oxlint src",
    "test:unit": "vitest run",
    "prepack": "bun run build",
    "clean": "rm -rf dist"
  },
  "dependencies": {},
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typescript": "7.0.2",
    "vitest": "^4.1.0"
  }
}
