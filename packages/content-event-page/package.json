{
  "name": "@tixkit/content-event-page",
  "version": "0.1.0",
  "description": "Canonical Tixkit event-page document and validation contracts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tixkithq/tixkit.git",
    "directory": "packages/content-event-page"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "!dist/**/__tests__/**",
    "!dist/**/*.test.*",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./puck": {
      "types": "./dist/puck-contract.d.ts",
      "import": "./dist/puck-contract.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b",
    "lint": "oxlint src",
    "typecheck": "tsc -b",
    "test:unit": "vitest run",
    "prepack": "bun run build",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@tixkit/content-core": "0.1.0",
    "@tixkit/domain": "0.1.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "^4.1.0"
  }
}
