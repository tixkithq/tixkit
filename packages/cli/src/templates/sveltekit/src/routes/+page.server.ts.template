import { env } from '$env/dynamic/private';
import type { Actions } from './$types';
import { createCheckoutFormAction, createTixkitClient } from '@tixkit/sveltekit/server';

const client = createTixkitClient({
  apiKey: env.TIXKIT_API_KEY ?? 'tk_test_demo',
  apiBaseUrl: env.TIXKIT_API_URL ?? 'http://localhost:4000/v1',
});

export const actions: Actions = {
  checkout: createCheckoutFormAction(client, {
    successUrl: env.TIXKIT_SUCCESS_URL ?? 'http://localhost:__PORT__/success',
    cancelUrl: env.TIXKIT_CANCEL_URL ?? 'http://localhost:__PORT__/cancel',
  }),
};
