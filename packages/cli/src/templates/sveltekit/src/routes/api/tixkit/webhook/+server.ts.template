import { env } from '$env/dynamic/private';
import { json, type RequestHandler } from '@sveltejs/kit';
import { verifyTixkitWebhook } from '@tixkit/sveltekit/server';

export const POST: RequestHandler = async ({ request }) => {
  const body = await request.text();
  const signature = request.headers.get('tixkit-signature') ?? '';
  if (!verifyTixkitWebhook({ body, signature, secret: env.TIXKIT_WEBHOOK_SECRET ?? '' })) {
    return json({ error: 'Invalid signature' }, { status: 401 });
  }

  try {
    return json({ received: true, event: JSON.parse(body) as unknown });
  } catch {
    return json({ error: 'Invalid JSON body' }, { status: 400 });
  }
};
