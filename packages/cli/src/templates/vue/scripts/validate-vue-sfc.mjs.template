import { existsSync } from 'node:fs';
import { spawnSync } from 'node:child_process';
import { readFile, readdir, rm, writeFile } from 'node:fs/promises';
import { dirname, join, relative, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';
import { compileScript, compileTemplate, parse } from '@vue/compiler-sfc';

const root = resolve(dirname(fileURLToPath(import.meta.url)), '..');
const temporaryFiles = [];
let vueFileCount = 0;
async function* vueFiles(directory) {
  for (const entry of await readdir(directory, { withFileTypes: true })) {
    if (entry.name.startsWith('.') || entry.name === 'node_modules') continue;
    const path = join(directory, entry.name);
    if (entry.isDirectory()) yield* vueFiles(path);
    else if (entry.isFile() && entry.name.endsWith('.vue')) yield path;
  }
}
const failures = [];
for await (const path of vueFiles(root)) {
  vueFileCount += 1;
  const filename = relative(root, path);
  const source = await readFile(path, 'utf8');
  const parsed = parse(source, { filename });
  failures.push(...parsed.errors.map((error) => `${filename}: ${String(error)}`));
  if (parsed.errors.length > 0) continue;
  const { descriptor } = parsed;
  let compiledScript;
  try {
    if (descriptor.script || descriptor.scriptSetup) {
      compiledScript = compileScript(descriptor, { id: filename });
      const temporaryPath = `${path}.tixkit-typecheck.ts`;
      temporaryFiles.push(temporaryPath);
      await writeFile(temporaryPath, descriptor.scriptSetup?.content ?? descriptor.script?.content ?? '', 'utf8');
    }
  } catch (error) {
    failures.push(`${filename}: ${error instanceof Error ? error.message : String(error)}`);
  }
  if (descriptor.template) {
    const result = compileTemplate({
      id: filename,
      filename,
      source: descriptor.template.content,
      compilerOptions: { bindingMetadata: compiledScript?.bindings },
    });
    failures.push(...result.errors.map((error) => `${filename}: ${String(error)}`));
    const unknownBindings = [...result.code.matchAll(/_ctx\.([A-Za-z_$][\w$]*)/g)].map((match) => match[1]);
    for (const binding of new Set(unknownBindings)) failures.push(`${filename}: template references unknown setup binding ${binding}`);
  }
}
if (vueFileCount === 0) failures.push('No .vue files found; refusing to pass an empty SFC gate');
if (failures.length === 0) {
  let current = root;
  let compilerPath;
  while (true) {
    const candidate = join(current, 'node_modules', 'typescript', 'bin', 'tsc');
    if (existsSync(candidate)) { compilerPath = candidate; break; }
    const parent = dirname(current);
    if (parent === current) break;
    current = parent;
  }
  if (!compilerPath) failures.push('TypeScript 7 compiler executable was not found');
  else {
    const result = spawnSync(process.execPath, [compilerPath, '--noEmit', '-p', join(root, 'tsconfig.json')], { cwd: root, encoding: 'utf8' });
    if (result.status !== 0) failures.push(`TypeScript 7 SFC bridge check failed:\n${result.stdout}${result.stderr}`);
  }
}
await Promise.all(temporaryFiles.map((path) => rm(path, { force: true })));
if (failures.length > 0) {
  console.error(`Vue SFC validation failed:\n${failures.map((failure) => `- ${failure}`).join('\n')}`);
  process.exit(1);
}
console.log('Validated Nuxt Vue SFC structure; TypeScript 7 checks extracted application logic.');
