<template>
  <main style="font-family: system-ui, sans-serif; max-width: 960px; margin: 0 auto; padding: 32px">
    <h1>__TITLE__</h1>
    <p>Demonstrates the @tixkit/vue SDK: widget iframe, checkout handoff, and lifecycle events.</p>

    <section style="margin-top: 24px">
      <h2>Inline Widget</h2>
      <iframe
        id="tixkit-widget-demo"
        :src="widgetAttrs.src"
        :title="widgetAttrs.title"
        :sandbox="widgetAttrs.sandbox"
        :allow="widgetAttrs.allow"
        :referrerpolicy="widgetAttrs.referrerPolicy as ReferrerPolicy"
        style="width: 100%; height: 560px; border: 0"
      ></iframe>
    </section>

    <section style="margin-top: 24px">
      <h2>Checkout Handoff URL</h2>
      <code data-testid="checkout-handoff-url">{{ checkoutHandoffUrl }}</code>
    </section>

    <section style="margin-top: 24px">
      <h2>Lifecycle Events</h2>
      <output aria-label="Tixkit lifecycle events">{{ events.join(', ') || 'No events yet' }}</output>
    </section>
  </main>
</template>

<script setup lang="ts">
import { checkoutUrl, tixkitWidgetIframeAttributes, parseTixkitWidgetMessage } from '@tixkit/vue';

const config = useRuntimeConfig();
const checkoutBaseUrl = config.public.tixkitCheckoutUrl as string;

const events = ref<string[]>([]);

const widgetAttrs = tixkitWidgetIframeAttributes({
  widgetBaseUrl: checkoutBaseUrl,
  brand: '__BRAND_ID__',
  event: '__EVENT_ID__',
  mode: 'inline',
  title: 'Tixkit Ticket Widget',
});

const checkoutHandoffUrl = checkoutUrl({
  event: '__EVENT_ID__',
  brand: '__BRAND_ID__',
  items: [{ ticketTypeId: '__TICKET_TYPE_ID__', quantity: 2 }],
  checkoutBaseUrl,
});

onMounted(() => {
  window.addEventListener('message', (message) => {
    const parsed = parseTixkitWidgetMessage(message, new URL(checkoutBaseUrl).origin);
    if (parsed) {
      events.value.push(parsed.type);
    }
  });
});
</script>
