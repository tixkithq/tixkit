{
  "name": "tixkit",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Tixkit developer-experience CLI: quickstart, setup validation, and local webhook automation",
  "license": "MIT",
  "main": "./dist/index.js",
  "bin": {
    "tixkit": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -b --force && cp -R src/templates dist/templates",
    "prepack": "bun run build",
    "lint": "oxlint src",
    "typecheck": "tsc -b",
    "test:unit": "vitest run src/__tests__",
    "init": "bun run src/index.ts init",
    "embed:generate": "bun run src/index.ts embed:generate",
    "quickstart": "bun run src/index.ts quickstart",
    "seed:sample-data": "bun run src/index.ts seed:sample-data",
    "sandbox:reset": "bun run src/index.ts sandbox:reset",
    "sandbox:initialize": "bun run src/index.ts sandbox:initialize",
    "seed:email-templates": "bun run src/index.ts seed:email-templates",
    "setup:check": "bun run src/index.ts setup:check",
    "dev:webhooks": "bun run src/index.ts dev:webhooks",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@tixkit/content-email": "workspace:*",
    "@tixkit/db": "workspace:*",
    "@tixkit/domain": "workspace:*",
    "@tixkit/embed-core": "1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "7.0.2",
    "vitest": "^4.1.0"
  }
}
