{
  "name": "@tixkit/db",
  "version": "0.1.0",
  "description": "Tixkit database schema, migrations, and tenant-safe repositories",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tixkit/tixkit.git",
    "directory": "packages/db"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/__tests__",
    "!dist/**/*.test.*",
    "!dist/.tsbuildinfo",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./migrations": {
      "types": "./dist/migrations/index.d.ts",
      "import": "./dist/migrations/index.js"
    },
    "./repositories": {
      "types": "./dist/repositories/index.d.ts",
      "import": "./dist/repositories/index.js"
    },
    "./migrate": {
      "types": "./dist/migrate.d.ts",
      "import": "./dist/migrate.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b",
    "lint": "oxlint src",
    "typecheck": "tsc -b",
    "migrate": "tsx src/migrate.ts",
    "migrate:mysql": "DB_DRIVER=mysql tsx src/migrate.ts",
    "migrate:mssql": "DB_DRIVER=mssql tsx src/migrate.ts",
    "reset": "tsx src/reset.ts",
    "reset:mysql": "DB_DRIVER=mysql tsx src/reset.ts",
    "reset:mssql": "DB_DRIVER=mssql tsx src/reset.ts",
    "test:unit": "vitest run src/__tests__/unit",
    "test:integration": "vitest run src/__tests__/integration --maxWorkers=1",
    "test:mysql": "DB_INTEGRATION_DRIVER=mysql vitest run src/__tests__/integration --maxWorkers=1",
    "test:mssql": "DB_INTEGRATION_DRIVER=mssql vitest run src/__tests__/integration --maxWorkers=1",
    "prepack": "bun run build",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@tixkit/admin-table-core": "0.1.0",
    "@tixkit/agent-protocol": "0.1.0",
    "@tixkit/content-core": "0.1.0",
    "@tixkit/domain": "0.1.0",
    "kysely": "^0.29.0",
    "pg": "^8.22.0",
    "mysql2": "^3.22.0",
    "tarn": "^3.0.2",
    "tedious": "^18.6.1",
    "ulid": "^2.3.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "typescript": "7.0.2",
    "tsx": "^4.22.0",
    "vitest": "^4.1.0"
  }
}
