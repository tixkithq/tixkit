{
  "name": "@tixkit/sveltekit",
  "version": "0.1.0",
  "description": "Official SvelteKit integration for Tixkit",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tixkit/tixkit.git",
    "directory": "packages/sdk-sveltekit"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/__tests__",
    "!dist/**/*.test.*",
    "!dist/.tsbuildinfo",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./TixkitWidget.svelte": {
      "types": "./dist/TixkitWidget.svelte.d.ts",
      "svelte": "./dist/TixkitWidget.svelte",
      "default": "./dist/TixkitWidget.svelte"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b && cp src/TixkitWidget.svelte src/TixkitWidget.svelte.d.ts dist/",
    "lint": "oxlint src",
    "prepack": "bun run build",
    "typecheck": "tsc -b",
    "test:unit": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@tixkit/js": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "^4.1.0"
  }
}
