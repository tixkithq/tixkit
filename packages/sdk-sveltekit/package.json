{
  "name": "@tixkit/sveltekit",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./TixkitWidget.svelte": {
      "types": "./dist/TixkitWidget.svelte.d.ts",
      "svelte": "./dist/TixkitWidget.svelte",
      "default": "./dist/TixkitWidget.svelte"
    }
  },
  "scripts": {
    "build": "tsc -b && cp src/TixkitWidget.svelte src/TixkitWidget.svelte.d.ts dist/",
    "lint": "oxlint src",
    "prepack": "bun run build",
    "typecheck": "tsc -b",
    "test:unit": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@tixkit/js": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "^4.1.0"
  }
}
