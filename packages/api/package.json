{
  "name": "@gatekit/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "lint": "oxlint src",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run src/__tests__/*.test.ts",
    "test:integration": "vitest run src/__tests__/integration",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@gatekit/domain": "workspace:*",
    "@gatekit/db": "workspace:*",
    "@gatekit/workflows": "workspace:*",
    "@temporalio/client": "^1.18.0",
    "fastify": "^5.8.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^12.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/cookie": "^10.0.0",
    "@clerk/backend": "^3.8.0",
    "stripe": "^22.2.0",
    "ioredis": "^5.11.0",
    "ulid": "^2.3.0",
    "pino": "^10.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "tsx": "^4.22.0",
    "vitest": "^4.1.0",
    "@types/node": "^22.20.0",
    "pino-pretty": "^13.1.3"
  }
}
