{
  "name": "@tixkit/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "lint": "oxlint src -A no-async-endpoint-handlers",
    "typecheck": "tsc -b",
    "test:unit": "vitest run src/__tests__/*.test.ts",
    "test:integration": "vitest run src/__tests__/integration --maxWorkers=1",
    "test:coverage": "vitest run src/__tests__/*.test.ts --coverage",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@aws-sdk/s3-request-presigner": "^3.1075.0",
    "@clerk/backend": "^3.8.0",
    "@fastify/compress": "^9.0.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^12.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@tixkit/admin-table-core": "workspace:*",
    "@tixkit/content-core": "workspace:*",
    "@tixkit/content-email": "workspace:*",
    "@tixkit/content-event-page": "workspace:*",
    "@tixkit/content-message": "workspace:*",
    "@tixkit/db": "workspace:*",
    "@tixkit/domain": "workspace:*",
    "@tixkit/email-transport": "workspace:*",
    "@tixkit/shared": "workspace:*",
    "@tixkit/workflows": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "@temporalio/client": "^1.18.0",
    "@temporalio/interceptors-opentelemetry": "^1.18.1",
    "fastify": "^5.8.0",
    "ioredis": "^5.11.0",
    "jose": "^6.1.3",
    "kysely": "^0.29.0",
    "stripe": "^22.2.0",
    "ulid": "^2.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "tsx": "^4.22.0",
    "vitest": "^4.1.0",
    "@types/node": "^22.20.0",
    "pino-pretty": "^13.1.3",
    "@tixkit/openapi": "workspace:*"
  }
}
