{
  "name": "@tixkit/widget",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/tixkit-widget.js",
  "scripts": {
    "build": "tsc -b --noEmit && esbuild src/index.ts --bundle --minify --format=esm --outfile=dist/tixkit-widget.js",
    "dev": "esbuild src/index.ts --bundle --format=esm --outfile=dist/tixkit-widget.js --watch",
    "lint": "oxlint src",
    "typecheck": "tsc -b",
    "test:unit": "vitest run",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "esbuild": "^0.28.0",
    "vitest": "^4.1.0",
    "jsdom": "^26.1.0"
  }
}
