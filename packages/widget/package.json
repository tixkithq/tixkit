{
  "name": "@tixkit/widget",
  "version": "0.1.1",
  "description": "Tixkit Embed Contract v1 custom elements for hosted checkout",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tixkit/tixkit.git",
    "directory": "packages/widget"
  },
  "homepage": "https://github.com/tixkit/tixkit#readme",
  "bugs": "https://github.com/tixkit/tixkit/issues",
  "type": "module",
  "sideEffects": [
    "./dist/index.js",
    "./dist/tixkit-widget.js"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/__tests__",
    "!dist/**/*.test.*",
    "!dist/.tsbuildinfo",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/tixkit-widget.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -b && esbuild src/browser.ts --bundle --minify --format=esm --sourcemap=external --outfile=dist/tixkit-widget.js",
    "build:release": "node ../../scripts/build-widget-release.mjs",
    "dev": "esbuild src/browser.ts --bundle --format=esm --outfile=dist/tixkit-widget.js --watch",
    "lint": "oxlint src",
    "typecheck": "tsc -b",
    "test:unit": "vitest run",
    "prepack": "bun run build",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@tixkit/embed-core": "1.0.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "esbuild": "^0.28.0",
    "vitest": "^4.1.0",
    "jsdom": "^26.1.0"
  }
}
