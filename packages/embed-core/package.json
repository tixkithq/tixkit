{
  "name": "@tixkit/embed-core",
  "version": "1.0.0",
  "description": "Versioned Tixkit embed contracts, validation, snippet generation, and CSP profiles",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tixkithq/tixkit.git",
    "directory": "packages/embed-core"
  },
  "homepage": "https://github.com/tixkithq/tixkit#readme",
  "bugs": "https://github.com/tixkithq/tixkit/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/__tests__",
    "!dist/**/*.test.*",
    "!dist/.tsbuildinfo",
    "schemas",
    "fixtures",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/*": "./schemas/*",
    "./fixtures/*": "./fixtures/*",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "lint": "oxlint src",
    "typecheck": "tsc -b",
    "test:unit": "vitest run",
    "prepack": "bun run build",
    "clean": "rm -rf dist"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "^4.1.0"
  }
}
