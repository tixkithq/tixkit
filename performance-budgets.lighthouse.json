{
  "$schema": "./scripts/performance-budgets.schema.json",
  "lighthouseReports": [
    {
      "label": "checkout flow Lighthouse",
      "path": "artifacts/performance/lighthouse/checkout-flow.json",
      "expectedUrlPattern": "^http://localhost:3201/checkout\\?eventId=[A-Za-z0-9_-]+$",
      "lighthouseVersion": "12.8.2",
      "minPerformanceScore": 0.8,
      "audits": [
        {
          "label": "largest contentful paint",
          "id": "largest-contentful-paint",
          "maxNumericValue": 2500,
          "unit": "ms"
        },
        {
          "label": "total blocking time",
          "id": "total-blocking-time",
          "maxNumericValue": 300,
          "unit": "ms"
        },
        {
          "label": "cumulative layout shift",
          "id": "cumulative-layout-shift",
          "maxNumericValue": 0.1,
          "unit": "score"
        }
      ]
    },
    {
      "label": "hosted event page Lighthouse",
      "path": "artifacts/performance/lighthouse/hosted-event-page.json",
      "expectedUrlPattern": "^http://localhost:3201/e/[A-Za-z0-9_-]+$",
      "lighthouseVersion": "12.8.2",
      "minPerformanceScore": 0.8,
      "audits": [
        {
          "label": "largest contentful paint",
          "id": "largest-contentful-paint",
          "maxNumericValue": 2500,
          "unit": "ms"
        },
        {
          "label": "total blocking time",
          "id": "total-blocking-time",
          "maxNumericValue": 300,
          "unit": "ms"
        },
        {
          "label": "cumulative layout shift",
          "id": "cumulative-layout-shift",
          "maxNumericValue": 0.1,
          "unit": "score"
        }
      ]
    },
    {
      "label": "admin shell Lighthouse",
      "path": "artifacts/performance/lighthouse/admin-shell.json",
      "expectedUrlPattern": "^http://localhost:3202/dashboard$",
      "lighthouseVersion": "12.8.2",
      "minPerformanceScore": 0.75,
      "audits": [
        {
          "label": "largest contentful paint",
          "id": "largest-contentful-paint",
          "maxNumericValue": 3000,
          "unit": "ms"
        },
        {
          "label": "total blocking time",
          "id": "total-blocking-time",
          "maxNumericValue": 500,
          "unit": "ms"
        },
        {
          "label": "cumulative layout shift",
          "id": "cumulative-layout-shift",
          "maxNumericValue": 0.1,
          "unit": "score"
        }
      ]
    }
  ]
}
